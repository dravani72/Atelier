etch-450a90ffa8.png","boardId":null},{"id":"motionstoryboard-cj","type":"note","x":1600,"y":1176,"w":500,"h":87,"title":"08 — End card","body":"Logo, URL, “Give monthly”.","color":"plain","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"motionstoryboard-ck","type":"timeline","x":40,"y":1311,"w":2060,"h":240,"title":"Animatic — 25 fps, locked to VO","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"timeline":{"mode":"timecode","fps":[25,1],"drop":false,"start":0,"end":2250,"links":false,"items":[{"id":"motionstoryboard-tw","card":"motionstoryboard-c4","at":0,"len":200,"lane":0},{"id":"motionstoryboard-tx","card":"motionstoryboard-c6","at":200,"len":300,"lane":0},{"id":"motionstoryboard-ty","card":"motionstoryboard-c8","at":500,"len":300,"lane":0},{"id":"motionstoryboard-tz","card":"motionstoryboard-ca","at":800,"len":300,"lane":0},{"id":"motionstoryboard-t10","card":"motionstoryboard-cc","at":1100,"len":350,"lane":0},{"id":"motionstoryboard-t11","card":"motionstoryboard-ce","at":1450,"len":350,"lane":0},{"id":"motionstoryboard-t12","card":"motionstoryboard-cg","at":1800,"len":250,"lane":0},{"id":"motionstoryboard-t13","card":"motionstoryboard-ci","at":2050,"len":200,"lane":0}]}},{"id":"motionstoryboard-cm","type":"note","x":56,"y":1654,"w":488,"h":107,"title":"Rules","body":"Every scene grows out of the last one. No cuts — only morphs and wipes made of leaves.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"motionstoryboard-cl"},{"id":"motionstoryboard-co","type":"note","x":616,"y":1654,"w":488,"h":107,"title":"Read","body":"Warm, unhurried, ~120 words. Breath before “And you can follow yours.”","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"motionstoryboard-cn"},{"id":"motionstoryboard-cq","type":"note","x":1176,"y":1654,"w":488,"h":1