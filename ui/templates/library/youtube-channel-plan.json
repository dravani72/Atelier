edia":"","filename":"","boardId":null},{"id":"youtubechannelplan-c2","type":"heading","x":40,"y":40,"w":1180,"h":67,"title":"Fix & Mend — channel plan","body":"A repair-and-reuse channel: fixing everyday things instead of replacing them. One long video a week, three Shorts.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"youtubechannelplan-c3","type":"sticky","x":1260,"y":40,"w":380,"h":200,"title":"How to use this template","body":"Fill the promise and the audience first — every other decision on this board should be checked against them. Revisit the goals every quarter.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"youtubechannelplan-c5","type":"note","x":56,"y":335,"w":308,"h":127,"title":"In one sentence","body":"Every week, we fix one thing you were about to throw away — and show you how to fix it yourself in under an hour.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"youtubechannelplan-c4"},{"id":"youtubechannelplan-c6","type":"note","x":56,"y":478,"w":308,"h":127,"title":"Why us","body":"Twenty years of repair-café experience. Calm, clear, no sponsorship of new products.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"youtubechannelplan-c4"},{"id":"youtubechannelplan-c7","type":"note","x":56,"y":621,"w":308,"h":107,"title":"Channel name & handle","body":"**Fix & Mend** · @fixandmend — available on YouTube, Instagram and TikTok.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"youtubechannelplan-c4"},{"id":"youtubechannelplan-c9","type":"note","x":436,"y":335,"w":308,"h":127,"title":"Who","body":"Renters and first-time homeowners, 22–40, mildly handy, environmentally minded, short on money and time.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"youtubechannelplan-c8"},{"id":"youtubechannelplan-ca","type":"note","x":436,"y":478,"w":308,"h":107,"title":"What they search","body":"“how to fix…”, “why does my … keep…”, “is it worth repairing…”","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"youtubechannelplan-c8"},{"id":"youtubechannelplan-cb","type":"image","x":436,"y":601,"w":308,"h":245,"title":"The world of the channel","body":"Photo: Repair Café Trier Reparatur — RaMa2016. CC BY-SA 4.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Repair_Caf%C3%A9_Trier_Reparatur.jpg","media":"@image:ph-yt-repair-bench","filename":"ph-yt-repair-bench.jpg","boardId":null,"sectionId":"youtubechannelplan-c8"},{"id":"youtubechannelplan-cd","type":"note","x":816,"y":335,"w":328,"h":107,"title":"1 · The weekly fix","body":"A full repair start to finish: zip, kettle, chair leg, phone screen. 12–18 min.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"youtubechannelplan-cc"},{"id":"youtubechannelplan-ce","type":"note","x":816,"y":454,"w":328,"h":107,"title":"2 · Worth fixing?","body":"Cost of repair vs replacement, with real numbers. 8–10 min.","color":"sage","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"youtubechannelplan-cc"},{"id":"youtubechannelplan-cf","type":"note","x":816,"y":573,"w":328,"h":87,"title":"3 · Tool school","body":"One tool, five uses. 6–8 min, evergreen.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"youtubechannelplan-cc"},{"id":"youtubechannelplan-cg","type":"note","x":816,"y":672,"w":328,"h":107,"title":"Shorts","body":"The satisfying moment from each fix, plus a one-line tip. 3 per week.","color":"rose","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"youtubechannelplan-cc"},{"id":"youtubechannelplan-ci","type":"image","x":1216,"y":335,"w":308,"h":194,"title":"Channel colours","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:gen-palette-b392e34675","filename":"gen-palette-b392e34675.png","boardId":null,"sectionId":"youtubechannelplan-ch"},{"id":"youtubechannelplan-cj","type":"image","x":1216,"y":545,"w":308,"h":231,"title":"Thumbnail type: Archivo Black","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:gen-type-062d28e595","filename":"gen-type-062d28e595.png","boardId":null,"sectionId":"youtubechannelplan-ch"},{"id":"youtubechannelplan-ck","type":"note","x":1216,"y":792,"w":308,"h":127,"title":"Thumbnails","body":"Before/after split, one object, three words max. Face only when the expression tells the story.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"youtubechannelplan-ch"},{"id":"youtubechannelplan-cm","type":"table","x":1596,"y":335,"w":308,"h":350,"title":"Targets","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Metric","Q1","Q4"],["Subscribers","1,000","25,000"],["Avg view duration","40%","50%"],["Uploads (long)","13","52"],["Email list","300","4,000"],["Monthly revenue","£0","£1,500"]],"sectionId":"youtubechannelplan-cl"},{"id":"youtubechannelplan-cn","type":"note","x":1596,"y":701,"w":308,"h":127,"title":"What success feels like","body":"Viewers send us photos of things they fixed. That is the metric we actually care about.","color":"sage","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"youtubechannelplan-cl"},{"id":"youtubechannelplan-cp","type":"table","x":56,"y":1046,"w":688,"h":274,"title":"Week","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Day","What","Where"],["Mon","Shorts #1","YT, IG, TikTok"],["Wed","Shorts #2","YT, IG, TikTok"],["Thu 17:00","Long video","YouTube"],["Thu","Community post + newsletter","YT, email"],["Sat","Shorts #3","YT, IG, TikTok"]],"sectionId":"youtubechannelplan-co"},{"id":"youtubechannelplan-cr","type":"task","x":816,"y":1046,"w":488,"h":233,"title":"Revenue steps","body":"","color":"paper","tags":[],"comments":[],"items":[{"id":"youtubechannelplan-is","text":"Partner programme (1k subs, 4k hours)","done":false},{"id":"youtubechannelplan-it","text":"Affiliate links for tools we actually use","done":false},{"id":"youtubechannelplan-iu","text":"Repair kits — own product, Q3","done":false},{"id":"youtubechannelplan-iv","text":"Workshops at local repair cafés","done":false},{"id":"youtubechannelplan-iw","text":"No sponsorships from fast-fashion or disposable brands","done":false}],"url":"","media":"","filename":"","boardId":null,"sectionId":"youtubechannelplan-cq"},{"id":"youtubechannelplan-cy","type":"note","x":1376,"y":1046,"w":488,"h":107,"title":"Burnout","body":"One long video a week is a lot for two people. Batch-film two fixes per shoot day.","color":"rose","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"youtubechannelplan-cx"},{"id":"youtubechannelplan-cz","type":"note","x":1376,"y":1169,"w":488,"h":107,"title":"Safety","body":"Electrical repairs carry a clear warning and we never open mains appliances on camera without an isolation step.","color":"rose","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"youtubechannelplan-cx"}],"edges":[],"view":{"x":60,"y":50,"zoom":0.8},"updated":0,"template":{"id":"lib-youtube-channel-plan","version":"1.0.0"}}]}