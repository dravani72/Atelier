":null},{"id":"podcastshowplan-c2","type":"heading","x":40,"y":40,"w":1180,"h":67,"title":"Small Hours — show plan","body":"A weekly interview show with people who work while the rest of us sleep: bakers, nurses, tug pilots, astronomers.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"podcastshowplan-c3","type":"sticky","x":1260,"y":40,"w":380,"h":200,"title":"How to use this template","body":"Lock the premise and the format before you book guests. A listener should be able to describe the show in one sentence after one episode.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"podcastshowplan-c5","type":"note","x":56,"y":335,"w":308,"h":107,"title":"One line","body":"Conversations with night workers about what the world looks like at 3 a.m.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"podcastshowplan-c4"},{"id":"podcastshowplan-c6","type":"note","x":56,"y":458,"w":308,"h":127,"title":"Why now","body":"Night work is invisible and growing. The guests are warm, funny and never asked about their jobs.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"podcastshowplan-c4"},{"id":"podcastshowplan-c7","type":"image","x":56,"y":601,"w":308,"h":225,"title":"The world of the show","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:ph-pod-night-city","filename":"ph-pod-night-city.jpg","boardId":null,"sectionId":"podcastshowplan-c4"},{"id":"podcastshowplan-c9","type":"note","x":436,"y":335,"w":308,"h":127,"title":"For","body":"Insomniacs, shift workers and curious listeners who like slow, human radio. Listens on headphones, late, alone.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"podcastshowplan-c8"},{"id":"podcastshowplan-ca","t