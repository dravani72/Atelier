{"format":"atelier-package","version":1,"name":"Game level design","generator":"Atelier template library","boards":[{"id":"gameleveldesign-b1","name":"Game level design","parent":null,"description":"Plan a level’s layout, flow, obstacles, teaching moments and difficulty curve, with a top-down sketch and a beat-by-beat breakdown.","color":"theme","cards":[{"id":"gameleveldesign-c5","type":"column","x":780,"y":280,"w":420,"h":638,"title":"Beats","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"gameleveldesign-cb","type":"column","x":1240,"y":280,"w":420,"h":459,"title":"Difficulty","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"gameleveldesign-c2","type":"heading","x":40,"y":40,"w":1180,"h":67,"title":"Level design — Tidewater, island 2 “The Crab Shallows”","body":"Teaches: creatures move with the tide. Three puzzles, one secret, ~15 minutes.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"gameleveldesign-c3","type":"sticky","x":1260,"y":40,"w":380,"h":200,"title":"How to use this template","body":"Sketch the layout top-down, mark the critical path, then list beats in order: teach, test, twist. The difficulty column checks the curve against the island before and after.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"gameleveldesign-c4","type":"sketch","x":40,"y":280,"w":700,"h":495,"title":"Layout — critical path in red","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:gen-sketch-a2b0eb0ba7","filename":"gen-sketch-a2b0eb0ba7.png","boardId":null},{"id":"gameleveldesign-c6","type":"note","x":796,"y":335,"w":388,"h":107,"title":"1 · Teach","body":"Low tide: a crab blocks the sandbar. Raise the tide; it scuttles away. No way to fail.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"gameleveldesign-c5"},{"id":"gameleveldesign-c7","type":"note","x":796,"y":458,"w":388,"h":107,"title":"2 · Test","body":"P1: lure two crabs onto pressure plates using tide height.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"gameleveldesign-c5"},{"id":"gameleveldesign-c8","type":"note","x":796,"y":581,"w":388,"h":107,"title":"3 · Twist","body":"P2: a crab must be moved *against* the tide using a floating crate.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"gameleveldesign-c5"},{"id":"gameleveldesign-c9","type":"note","x":796,"y":704,"w":388,"h":87,"title":"4 · Master","body":"P3: three crabs, two plates, one crate.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"gameleveldesign-c5"},{"id":"gameleveldesign-ca","type":"note","x":796,"y":807,"w":388,"h":87,"title":"Secret","body":"Sea glass under the wreck, only at mid tide.","color":"sage","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"gameleveldesign-c5"},{"id":"gameleveldesign-cc","type":"image","x":1256,"y":335,"w":388,"h":257,"title":"Difficulty curve (target)","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:gen-chart-6e295fc34e","filename":"gen-chart-6e295fc34e.png","boardId":null,"sectionId":"gameleveldesign-cb"},{"id":"gameleveldesign-cd","type":"note","x":1256,"y":608,"w":388,"h":107,"title":"Check","body":"Island 2 should feel like 1.5× island 1 — playtest median ≤ 18 min.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"gameleveldesign-cb"}],"edges":[],"view":{"x":60,"y":50,"zoom":0.8},"updated":0,"template":{"id":"lib-game-level-design","version":"1.0.0"}}]}