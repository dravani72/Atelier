{"format":"atelier-package","version":1,"name":"Character design moodboard","generator":"Atelier template library","boards":[{"id":"characterdesignmoodboard-b1","name":"Character design moodboard","parent":null,"description":"Develop a character’s look, interests, environment and backstory through reference images, silhouettes, colour and notes.","color":"theme","cards":[{"id":"characterdesignmoodboard-c4","type":"column","x":40,"y":299,"w":340,"h":615,"title":"Resourceful and kind","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"characterdesignmoodboard-cg","type":"column","x":40,"y":977,"w":360,"h":574,"title":"Colour","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"characterdesignmoodboard-cn","type":"column","x":440,"y":977,"w":420,"h":360,"title":"Type","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"characterdesignmoodboard-cp","type":"column","x":900,"y":977,"w":360,"h":355,"title":"Texture & detail","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"characterdesignmoodboard-cr","type":"column","x":1300,"y":977,"w":340,"h":339,"title":"Use / avoid","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"characterdesignmoodboard-c2","type":"heading","x":40,"y":40,"w":1180,"h":67,"title":"Character — Wren, the lighthouse mechanic","body":"Playable lead for a cosy puzzle game. Age 17, fixes machines, talks to seabirds. Needs to read at 64 px.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"characterdesignmoodboard-c3","type":"sticky","x":1260,"y":40,"w":380,"h":219,"title":"How to use this template","body":"Collect widely, then edit hard: keep only references that say something the others don’t. Under each image, note what to borrow — the light, the colour, the composition — so the board guides decisions rather than just looking nice.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"characterdesignmoodboard-c5","type":"note","x":56,"y":354,"w":308,"h":127,"title":"The feeling","body":"Pockets full of bolts, hair full of salt. Competent in a crisis, awkward in conversation.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"characterdesignmoodboard-c4"},{"id":"characterdesignmoodboard-c6","type":"note","x":56,"y":497,"w":308,"h":107,"title":"Words","body":"Handy · windswept · curious · sturdy · warm","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"characterdesignmoodboard-c4"},{"id":"characterdesignmoodboard-c7","type":"note","x":56,"y":620,"w":308,"h":127,"title":"Silhouette","body":"Oversized oilskin coat, tool belt, a seabird on one shoulder: readable as a shape in black.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"characterdesignmoodboard-c4"},{"id":"characterdesignmoodboard-c8","type":"note","x":56,"y":763,"w":308,"h":127,"title":"Backstory","body":"Raised by the lighthouse keeper after a shipwreck. Collects broken things nobody else can fix.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"characterdesignmoodboard-c4"},{"id":"characterdesignmoodboard-c9","type":"image","x":420,"y":299,"w":560,"h":353,"title":"Her world","body":"Photo: Marshall Point Lighthouse Center — Photo by and (c)2014 Derek Ramsey ( Ram-Man ). CC BY-SA 4.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Marshall_Point_Lighthouse_Center.JPG","media":"@image:ph-ch-lighthouse","filename":"ph-ch-lighthouse.jpg","boardId":null},{"id":"characterdesignmoodboard-ca","type":"image","x":1020,"y":299,"w":270,"h":251,"title":"Costume: the coat","body":"Photo: Gabriel walking in the rain at dusk, Roma Avenue, Lisbon, Portugal julesvernex2 — Jules Verne Times Two. CC BY-SA 4.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Gabriel_walking_in_the_rain_at_dusk,_Roma_Avenue,_Lisbon,_Portugal_julesvernex2.jpg","media":"@image:ph-ch-oilskin","filename":"ph-ch-oilskin.jpg","boardId":null},{"id":"characterdesignmoodboard-cb","type":"image","x":1306,"y":299,"w":270,"h":371,"title":"Props: tool belt","body":"Photo: Ideal tool bag 2 — J.C. Fields ( Talk ) ( Uploads ). CC BY-SA 3.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Ideal_tool_bag_2.jpg","media":"@image:ph-ch-toolbelt","filename":"ph-ch-toolbelt.jpg","boardId":null},{"id":"characterdesignmoodboard-cc","type":"image","x":1592,"y":299,"w":270,"h":235,"title":"Companion: the gull","body":"Photo: American Herring Gull, Brooklyn Army Terminal (01813) — Rhododendrites. CC BY-SA 4.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:American_Herring_Gull,_Brooklyn_Army_Terminal_(01813).jpg","media":"@image:ph-ch-gull","filename":"ph-ch-gull.jpg","boardId":null},{"id":"characterdesignmoodboard-cd","type":"image","x":1020,"y":686,"w":270,"h":243,"title":"Her craft","body":"Photo: Clock Cogs — SomeDriftwood. CC BY 3.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Clock_Cogs.jpg","media":"@image:ph-ch-gears","filename":"ph-ch-gears.jpg","boardId":null},{"id":"characterdesignmoodboard-ce","type":"image","x":1306,"y":686,"w":270,"h":243,"title":"Pose and weather","body":"Photo: Hand in Hand Young Love (33048