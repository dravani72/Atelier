{"format":"atelier-package","version":1,"name":"Film moodboard","generator":"Atelier template library","boards":[{"id":"filmmoodboard-b1","name":"Film moodboard","parent":null,"description":"Define the visual language of a film — light, colour, framing, texture and movement — and share it with your DP, designer and costume team.","color":"theme","cards":[{"id":"filmmoodboard-c4","type":"column","x":40,"y":280,"w":300,"h":456,"title":"The feeling in three words","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmmoodboard-c7","type":"column","x":380,"y":280,"w":360,"h":756,"title":"Light","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmmoodboard-cb","type":"column","x":780,"y":280,"w":360,"h":462,"title":"Colour","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmmoodboard-cj","type":"column","x":1180,"y":280,"w":360,"h":699,"title":"Framing & lens","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmmoodboard-cm","type":"column","x":1580,"y":280,"w":360,"h":379,"title":"Texture & costume","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmmoodboard-cq","type":"column","x":40,"y":1084,"w":360,"h":528,"title":"Movement","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmmoodboard-ct","type":"column","x":440,"y":1084,"w":360,"h":361,"title":"Use / avoid","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmmoodboard-cw","type":"column","x":840,"y":1084,"w":360,"h":340,"title":"Questions for the DP","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmmoodboard-c12","type":"column","x":1240,"y":1084,"w":360,"h":482,"title":"Sign-off","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmmoodboard-c2","type":"heading","x":40,"y":40,"w":1180,"h":67,"title":"Night Shift — visual direction","body":"A neo-noir feature set over one night in a 24-hour laundrette. This board is the single reference for camera, art and costume.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmmoodboard-c3","type":"sticky","x":1260,"y":40,"w":380,"h":200,"title":"How to use this template","body":"Group references by the decision they inform, not by where you found them. Write one line under each saying what to borrow — and what to ignore.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmmoodboard-c5","type":"note","x":56,"y":335,"w":268,"h":167,"title":"Lonely · luminous · humid","body":"The city is asleep; the laundrette is the only warm, lit box on the street. Every frame should feel like 3 a.m. — tired, but strangely tender.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmmoodboard-c4"},{"id":"filmmoodboard-c6","type":"note","x":56,"y":518,"w":268,"h":194,"title":"Tone references","body":"- *Night-time photography* of empty shopfronts\n- 1970s colour stock with crushed shadows\n- Fluorescent light on wet pavement","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmmoodboard-c4"},{"id":"filmmoodboard-c8","type":"image","x":396,"y":335,"w":328,"h":259,"title":"Practicals only — borrow","body":"Photo: DFC 0506 Wet neon reflections line a quiet city street at night the glow of bars and signs mirrored in puddles — PattayaPatrol. CC BY-SA 4.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:DFC_0506_Wet_neon_reflections_line_a_quiet_city_street_at_night_the_glow_of_bars_and_signs_mirrored_in_puddles.jpg","media":"@image:ph-mood-neon-rain","filename":"ph-mood-neon-rain.jpg","boardId":null,"sectionId":"filmmoodboard-c7"},{"id":"filmmoodboard-c9","type":"image","x":396,"y":610,"w":328,"h":259,"title":"The set at its emptiest","body":"Photo: Laundromat Wasknijper Breda at night — Renée Kools. CC BY-SA 4.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Laundromat_Wasknijper_Breda_at_night.png","media":"@image:ph-mood-laundromat","filename":"ph-mood-laundromat.jpg","boardId":null,"sectionId":"filmmoodboard-c7"},{"id":"filmmoodboard-ca","type":"note","x":396,"y":885,"w":328,"h":127,"title":"Lighting rules","body":"Motivated by practicals only: tubes, signs, the dryer windows. Faces sit half in shadow. Never add a hair light.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmmoodboard-c7"},{"id":"filmmoodboard-cc","type":"image","x":796,"y":335,"w":98,"h":114,"title":"Midnight · #0F2A3A","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:gen-swatch-0f2a3a-midnight-s","filename":"gen-swatch-0f2a3a-midnight-s.png","boardId":null,"sectionId":"filmmoodboard-cb"},{"id":"filmmoodboard-cd","type":"image","x":906,"y":335,"w":98,"h":114,"title":"Teal tube · #1F6F78","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:gen-swatch-1f6f78-tealtube-s","filename":"gen-swatch-1f6f78-tealtube-s.png","boardId":null,"sectionId":"filmmoodboard-cb"},{"id":"filmmoodboard-ce","type":"image","x":1016,"y":335,"w":98,"h":114,"title":"Sodium · #E6B655","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:gen-swatch-e6b655-sodium-s","filename":"gen-swatch-e6b655-sodium-s.png","boardId":null,"sectionId":"filmmoodboard-cb"},{"id":"filmmoodboard-cf","type":"image","x":796,"y":461,"w":98,"h":114,"title":"Exit sign · #D9483B","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:gen-swatch-d9483b-exitsign-s","filename":"gen-swatch-d9483b-exitsign-s.png","boardId":null,"sectionId":"filmmoodboard-cb"},{"id":"filmmoodboard-cg","type":"image","x":906,"y":461,"w":98,"h":114,"title":"Bleached cotton · #EFE9DD","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:gen-swatch-efe9dd-bleachedcotton-s","filename":"gen-swatch-efe9dd-bleachedcotton-s.png","boardId":null,"sectionId":"filmmoodboard-cb"},{"id":"filmmoodboard-ch","type":"image","x":1016,"y":461,"w":98,"h":114,"title":"Wet tarmac · #2A2A2E","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:gen-swatch-2a2a2e-wettarmac-s","filename":"gen-swatch-2a2a2e-wettarmac-s.png","boardId":null,"sectionId":"filmmoodboard-cb"},{"id":"filmmoodboard-ci","type":"note","x":796,"y":591,"w":328,"h":127,"title":"Colour script","body":"Cold teal outside, warm sodium inside. The red exit sign is the only red — save it for the moment she decides to leave.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmmoodboard-cb"},{"id":"filmmoodboard-ck","type":"image","x":1196,"y":335,"w":328,"h":477,"title":"Through-glass compositions","body":"Photo: Night Diners, Asakusa (19818655873) — Stephen Kelly from San Francisco, CA, USA. CC BY 2.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Night_Diners,_Asakusa_(19818655873).jpg","media":"@image:ph-mood-diner-window","filename":"ph-mood-diner-window.jpg","boardId":null,"sectionId":"filmmoodboard-cj"},{"id":"filmmoodboard-cl","type":"note","x":1196,"y":828,"w":328,"h":127,"title":"Camera","body":"Anamorphic 40 mm and 75 mm. Static, symmetrical wides through the shop window; handheld only inside, close and breathing.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmmoodboard-cj"},{"id":"filmmoodboard-cn","type":"image","x":1596,"y":335,"w":156,"h":144,"title":"Fabric — soft, worn","body":"Photo: Crumpled duvet covered with a white cotton duvet cover 3 — W.carter. CC0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Crumpled_duvet_covered_with_a_white_cotton_duvet_cover_3.jpg","media":"@image:ph-mood-fabric","filename":"ph-mood-fabric.jpg","boardId":null,"sectionId":"filmmoodboard-cm"},{"id":"filmmoodboard-co","type":"image","x":1768,"y":335,"w":156,"h":157,"title":"Surfaces — tiled, steamy","body":"Photo: Green ceramic tiles on The Hare on the Hill - geograph.org.uk - 6133166 — Neil Owen. CC BY-SA 2.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Green_ceramic_tiles_on_The_Hare_on_the_Hill_-_geograph.org.uk_-_6133166.jpg","media":"@image:ph-mood-tiles","filename":"ph-mood-tiles.jpg","boardId":null,"sectionId":"filmmoodboard-cm"},{"id":"filmmoodboard-cp","type":"note","x":1596,"y":508,"w":328,"h":127,"title":"Costume","body":"Worn-in cottons and nylon. Nothing new, nothing branded. The lead’s yellow cardigan is the warmest object on screen.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmmoodboard-cm"},{"id":"filmmoodboard-cr","type":"note","x":56,"y":1139,"w":328,"h":147,"title":"How the camera moves","body":"Slow push-ins when someone is about to speak and doesn’t. One long Steadicam take follows her outside at the end — the only time the camera leaves the shop.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmmoodboard-cq"},{"id":"filmmoodboard-cs","type":"image","x":56,"y":1302,"w":328,"h":286,"title":"The final walk","body":"Photo: Empty streets of Göreme at night — Slyronit. CC BY-SA 4.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Empty_streets_of_G%C3%B6reme_at_night.jpg","media":"@image:ph-mood-street-night","filename":"ph-mood-street-night.jpg","boardId":null,"sectionId":"filmmoodboard-cq"},{"id":"filmmoodboard-cu","type":"note","x":456,"y":1139,"w":328,"h":133,"title":"Use","body":"- Reflections in glass and chrome\n- Condensation and steam\n- Negative space above heads","color":"sage","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmmoodboard-ct"},{"id":"filmmoodboard-cv","type":"note","x":456,"y":1288,"w":328,"h":133,"title":"Avoid","body":"- Blue-orange “blockbuster” grading\n- Lens flares as decoration\n- Drone shots","color":"rose","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmmoodboard-ct"},{"id":"filmmoodboard-cx","type":"task","x":856,"y":1139,"w":328,"h":261,"title":"To decide at the camera test","body":"","color":"paper","tags":[],"comments":[],"items":[{"id":"filmmoodboard-iy","text":"Diffusion: 1/8 Black Pro-Mist or none?","done":false},{"id":"filmmoodboard-iz","text":"How far can we push the stock before the shadows break?","done":false},{"id":"filmmoodboard-i10","text":"Practical tubes: daylight or tungsten-balanced?","done":false},{"id":"filmmoodboard-i11","text":"Window reflections — polariser or embrace them?","done":false}],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmmoodboard-cw"},{"id":"filmmoodboard-c13","type":"table","x":1256,"y":1139,"w":328,"h":260,"title":"Approvals","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Department","Who","Status"],["Director","—","Approved"],["DP","—","Approved"],["Production design","—","Notes"],["Costume","—","Pending"]],"sectionId":"filmmoodboard-c12"},{"id":"filmmoodboard-c14","type":"note","x":1256,"y":1415,"w":328,"h":127,"title":"Next step","body":"Bring this board to the camera test on day −10 and shoot every swatch under the practicals.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmmoodboard-c12"}],"edges":[],"view":{"x":60,"y":50,"zoom":0.8},"updated":0,"template":{"id":"lib-film-moodboard","version":"1.0.0"}}]}