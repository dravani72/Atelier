"sectionId":"brandpersonality-cc"},{"id":"brandpersonality-ce","type":"note","x":816,"y":438,"w":308,"h":87,"title":"Is not","body":"Patronising or overly cheerful.","color":"rose","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandpersonality-cc"},{"id":"brandpersonality-cf","type":"note","x":816,"y":541,"w":308,"h":123,"title":"Sounds like","body":"> “It’s been a while? Lots of people say that. Let’s start gently.”","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandpersonality-cc"},{"id":"brandpersonality-ch","type":"note","x":1196,"y":335,"w":308,"h":87,"title":"Is","body":"Expert, assured, no showing off.","color":"sage","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandpersonality-cg"},{"id":"brandpersonality-ci","type":"note","x":1196,"y":438,"w":308,"h":87,"title":"Is not","body":"Clinical, superior, salesy.","color":"rose","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandpersonality-cg"},{"id":"brandpersonality-cj","type":"note","x":1196,"y":541,"w":308,"h":123,"title":"Sounds like","body":"> “We do this every day. You’re in good hands.”","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandpersonality-cg"},{"id":"brandpersonality-cl","type":"table","x":1576,"y":335,"w":388,"h":298,"title":"Where we sit (1–5)","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["","1","→","5",""],["Formal","","●","","Casual"],["Serious","","","●","Playful"],["Clinical","","","","● Warm"],["Traditional","","●","","Modern"]],"sectionId":"brandpersonality-ck"},{"id":"brandpersonality-cm","type":"note","x":1576,"y":649,"w":388,"h":107,"title":"Read","body":"We sit a little casual, slightly playful, very warm, mid-modern.","color