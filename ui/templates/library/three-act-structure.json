{"format":"atelier-package","version":1,"name":"Three act structure","generator":"Atelier template library","boards":[{"id":"threeactstructure-b1","name":"Three act structure","parent":null,"description":"Plan a story in three parts — setup, confrontation, resolution — with the turning points that hinge them.","color":"theme","cards":[{"id":"threeactstructure-c4","type":"column","x":40,"y":280,"w":460,"h":475,"title":"Act one — setup (25%)","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"threeactstructure-ca","type":"column","x":800,"y":280,"w":460,"h":475,"title":"Act two — confrontation (50%)","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"threeactstructure-cg","type":"column","x":1560,"y":280,"w":460,"h":392,"title":"Act three — resolution (25%)","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"threeactstructure-c2","type":"heading","x":40,"y":40,"w":1180,"h":67,"title":"Three acts — The Glass Orchard","body":"The book at its simplest. If this board doesn’t work, no amount of good sentences will save the draft.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"threeactstructure-c3","type":"sticky","x":1260,"y":40,"w":380,"h":200,"title":"How to use this template","body":"Fill the three turning points first (the shapes): they are the hinges. Then fill each act with the three to five events that get you from one hinge to the next.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"threeactstructure-c5","type":"note","x":56,"y":335,"w":428,"h":87,"title":"Ordinary world","body":"Ines on the mainland, designing lamps she never touches.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"threeactstructure-c4"},{"id":"threeactstructure-c6","type":"note","x":56,"y":438,"w":428,"h":87,"title":"Inciting incident","body":"The call: Zsófia is dead.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"threeactstructure-c4"},{"id":"threeactstructure-c7","type":"note","x":56,"y":541,"w":428,"h":87,"title":"Setup","body":"Kesh, the furnace, Tomas, the ledger, Hale.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"threeactstructure-c4"},{"id":"threeactstructure-c8","type":"note","x":56,"y":644,"w":428,"h":87,"title":"Debate","body":"She plans to leave on Sunday.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"threeactstructure-c4"},{"id":"threeactstructure-c9","type":"shape","x":540,"y":280,"w":220,"h":240,"title":"Turning point 1","body":"Ines makes the first order instead of taking the ferry.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"shape":"diamond"},{"id":"threeactstructure-cb","type":"note","x":816,"y":335,"w":428,"h":87,"title":"Rising action","body":"She fulfils the orders; the island changes around her.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"threeactstructure-ca"},{"id":"threeactstructure-cc","type":"note","x":816,"y":438,"w":428,"h":87,"title":"Midpoint","body":"The orders are for the dead — and one is for her mother.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"threeactstructure-ca"},{"id":"threeactstructure-cd","type":"note","x":816,"y":541,"w":428,"h":87,"title":"Complications","body":"Tomas’s forgery; Hale’s claim; the furnace begins to fail.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"threeactstructure-ca"},{"id":"threeactstructure-ce","type":"note","x":816,"y":644,"w":428,"h":87,"title":"Low point","body":"The fight in the orchard. Tomas signs Hale’s papers.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"threeactstructure-ca"},{"id":"threeactstructure-cf","type":"shape","x":1300,"y":280,"w":220,"h":240,"title":"Turning point 2","body":"The last order is in Ines’s own handwriting.","color":"rose","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"shape":"diamond"},{"id":"threeactstructure-ch","type":"note","x":1576,"y":335,"w":428,"h":107,"title":"Climax","body":"Ines and Tomas make the last piece together as the furnace dies.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"threeactstructure-cg"},{"id":"threeactstructure-ci","type":"note","x":1576,"y":458,"w":428,"h":87,"title":"Resolution","body":"Hale leaves on the morning ferry, without the orchard.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"threeactstructure-cg"},{"id":"threeactstructure-cj","type":"note","x":1576,"y":561,"w":428,"h":87,"title":"New normal","body":"Ines stays for the winter. She lights the furnace herself.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"threeactstructure-cg"}],"edges":[],"view":{"x":60,"y":50,"zoom":0.8},"updated":0,"template":{"id":"lib-three-act-structure","version":"1.0.0"}}]}