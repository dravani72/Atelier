s":[],"url":"","media":"","filename":"","boardId":null},{"id":"novelresearch-c5","type":"link","x":56,"y":335,"w":348,"h":137,"title":"Glassblowing — overview","body":"Tools, stages, temperatures.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://en.wikipedia.org/wiki/Glassblowing","media":"","filename":"","boardId":null,"sectionId":"novelresearch-c4"},{"id":"novelresearch-c6","type":"note","x":56,"y":488,"w":348,"h":127,"title":"Vocabulary","body":"*Gather* — molten glass on the pipe. *Glory hole* — reheating furnace. *Marver* — steel table for shaping. *Annealer* — slow-cooling oven.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"novelresearch-c4"},{"id":"novelresearch-c7","type":"image","x":56,"y":631,"w":348,"h":301,"title":"Tools on the bench","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:ph-wri-glass-tools","filename":"ph-wri-glass-tools.jpg","boardId":null,"sectionId":"novelresearch-c4"},{"id":"novelresearch-c9","type":"image","x":476,"y":335,"w":348,"h":301,"title":"Kesh — the harbour","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:ph-wri-island-village","filename":"ph-wri-island-village.jpg","boardId":null,"sectionId":"novelresearch-c8"},{"id":"novelresearch-ca","type":"image","x":476,"y":652,"w":348,"h":301,"title":"The ferry","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:ph-wri-island-ferry","filename":"ph-wri-island-ferry.jpg","boardId":null,"sectionId":"novelresearch-c8"},{"id":"novelresearch-cb","type":"note","x":476,"y":969,"w":348,"h":107,"title":"Notes","body":"Two ferries a day in summer, one in winter. Everyone knows who is on it.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"novelresearch-c8"},{"id":"novelresearch-cd","type":"note","x":896,"y":335,"w":348,"h":127,"title":"Island glass traditions","body":"Real lagoon-glass islands kept glassmakers on the island to protect the secrets. Kesh inherits that idea, not the history.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"novelresearch-cc"},{"id":"novelresearch-ce","type":"link","x":896,"y":478,"w":348,"h":137,"title":"History of glass","body":"From Roman core-forming to studio glass.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://en.wikipedia.org/wiki/History_of_glass","media":"","filename":"","boardId":null,"sectionId":"novelresearch-cc"},{"id":"novelresearch-cg","type":"note","x":1316,"y":335,"w":348,"h":107,"title":"Heat","body":"The furnace runs at ~1,100 °C. Workers drink constantly; forearms have no hair.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"novelresearch-cf"},{"id":"novelresearch-ch","type":"note","x":1316,"y":458,"w":348,"h":107,"title":"Sound","body":"The roar of the glory hole; the *tink* of glass cracking off the punty.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"novelresearch-cf"},{"id":"novelresearch-ci","type":"note","x":1316,"y":581,"w":348,"h":107,"title":"Smell","body":"Hot metal, wet newspaper (used to shape glass), beeswax.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"novelresearch-cf"},{"id":"novelresearch-ck","type":"task","x":1736,"y":335,"w":328,"h":242,"title":"Open questions","body":"","color":"paper","tags":[],"comments":[],"items":[{"id":"novelresearch-il","text":"Can a furnace be kept lit for years?","done":false},{"id":"novelresearch-im","text":"How long does a large piece take to anneal?","done":false},{"id":"novelresearch-in","text":"What does a glassblower’s hand injury look like?","done":false},{"id":"novelresearch-io","text":"Visit: a working studio — book a da