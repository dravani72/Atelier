imedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Wood_letterpress_type.jpg","media":"@image:ph-gd-letterpress","filename":"ph-gd-letterpress.jpg","boardId":null},{"id":"graphicdesignmoodboard-ce","type":"image","x":1592,"y":558,"w":270,"h":243,"title":"Scale of the crowd","body":"Photo: Crowd Outlaw Music Festival Tour BankNH Pavilion 108 Kimball Road Gilford NH August 2025 02 — Artaxerxes. CC BY 4.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Crowd_Outlaw_Music_Festival_Tour_BankNH_Pavilion_108_Kimball_Road_Gilford_NH_August_2025_02.jpg","media":"@image:ph-gd-festival-crowd","filename":"ph-gd-festival-crowd.jpg","boardId":null},{"id":"graphicdesignmoodboard-cg","type":"image","x":56,"y":904,"w":156,"h":157,"title":"Trumpet red · #F2542D","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:gen-swatch-f2542d-trumpetred-s","filename":"gen-swatch-f2542d-trumpetred-s.png","boardId":null,"sectionId":"graphicdesignmoodboard-cf"},{"id":"graphicdesignmoodboard-ch","type":"image","x":224,"y":904,"w":156,"h":157,"title":"Brass · #F5A623","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:gen-swatch-f5a623-brass-s","filename":"gen-swatch-f5a623-brass-s.png","boardId":null,"sectionId":"graphicdesignmoodboard-cf"},{"id":"graphicdesignmoodboard-ci","type":"image","x":56,"y":1073,"w":156,"h":157,"title":"River teal · #0E9594","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:gen-swatch-0e9594-riverteal-s","filename":"gen-swatch-0e9594-riverteal-s.png","boardId":null,"sectionId":"graphicdesignmoodboard-cf"},{"id":"graphicdesignmoodboard-cj","type":"image","x":224,"y":1073,"w":156,"h":157,"title":"Deep water · #127475","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:gen-swatch-127475-deepwater-s","fi