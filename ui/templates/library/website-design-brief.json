","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"websitedesignbrief-c7"},{"id":"websitedesignbrief-c9","type":"table","x":456,"y":478,"w":328,"h":246,"title":"How we’ll measure it","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Measure","Target"],["Enquiries / month","12 (from 4)"],["Time on case studies","2 min+"],["Lighthouse accessibility","95+"]],"sectionId":"websitedesignbrief-c7"},{"id":"websitedesignbrief-cb","type":"note","x":856,"y":335,"w":328,"h":127,"title":"Who","body":"Homeowners planning a major extension or new build (budget £250k+), plus planners and press.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"websitedesignbrief-ca"},{"id":"websitedesignbrief-cc","type":"note","x":856,"y":478,"w":328,"h":127,"title":"Insight","body":"Clients choose an architect they trust to listen. Show the conversation, not just the result.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"websitedesignbrief-ca"},{"id":"websitedesignbrief-cd","type":"image","x":856,"y":621,"w":328,"h":265,"title":"Their work","body":"Photo: Modern house by the Oxford Canal - geograph.org.uk - 4839440 — David Howard. CC BY-SA 2.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Modern_house_by_the_Oxford_Canal_-_geograph.org.uk_-_4839440.jpg","media":"@image:ph-wb-modern-house","filename":"ph-wb-modern-house.jpg","boardId":null,"sectionId":"websitedesignbrief-ca"},{"id":"websitedesignbrief-cf","type":"note","x":1256,"y":335,"w":328,"h":87,"title":"Key message","body":"Thoughtful homes, made together.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"websitedesignbrief-ce"},{"id":"websitedesignbrief-cg","ty