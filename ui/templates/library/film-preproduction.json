{"format":"atelier-package","version":1,"name":"Film pre-production plan","generator":"Atelier template library","boards":[{"id":"filmpreproduction-b1","name":"Film pre-production plan","parent":null,"description":"Take a short film from locked script to first shoot day: story, look, team, locations, budget and an eight-week plan on a calendar timeline.","color":"theme","cards":[{"id":"filmpreproduction-c4","type":"column","x":40,"y":288,"w":330,"h":1069,"title":"The film","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmpreproduction-c9","type":"column","x":410,"y":288,"w":330,"h":986,"title":"Look & feel","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmpreproduction-ce","type":"column","x":780,"y":288,"w":330,"h":946,"title":"People","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmpreproduction-c12","type":"column","x":1150,"y":288,"w":330,"h":1068,"title":"Places","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmpreproduction-c18","type":"column","x":1520,"y":288,"w":440,"h":813,"title":"Budget — £18,400","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmpreproduction-c1b","type":"column","x":2000,"y":288,"w":300,"h":512,"title":"Risks","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmpreproduction-c1g","type":"column","x":40,"y":1895,"w":400,"h":283,"title":"Development","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmpreproduction-c1m","type":"column","x":480,"y":1895,"w":400,"h":283,"title":"Casting","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmpreproduction-c1s","type":"column","x":920,"y":1895,"w":400,"h":283,"title":"Scouting","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmpreproduction-c1y","type":"column","x":1360,"y":1895,"w":400,"h":254,"title":"Design","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmpreproduction-c23","type":"column","x":1800,"y":1895,"w":400,"h":583,"title":"Rehearsal & milestones","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmpreproduction-c2","type":"heading","x":40,"y":40,"w":1200,"h":67,"title":"Low Tide — a 12-minute short","body":"Pre-production hub. Everything the team needs between the locked script and the first day of shooting lives on this board.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmpreproduction-c3","type":"sticky","x":1280,"y":40,"w":380,"h":200,"title":"How to use this template","body":"Replace the example project with yours. Keep the structure: the film, the look, the people, the places, the money and the plan. Drag clips on the timeline to re-plan; the cards move with them.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmpreproduction-c5","type":"note","x":56,"y":343,"w":298,"h":203,"title":"Logline","body":"A teenage cockle-picker who knows the tides better than anyone has twelve minutes to get her stranded grandfather off the sandbanks before the water comes in — and to admit she left him there.","color":"paper","tags":["story"],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmpreproduction-c4"},{"id":"filmpreproduction-c6","type":"note","x":56,"y":562,"w":298,"h":292,"title":"Synopsis","body":"**Act one.** Mara (16) works the flats at dawn with her grandfather, Ted. They argue; she walks off with the only radio.\n\n**Act two.** The fog rolls in early. From the sea wall she hears the siren and realises Ted is still out there.\n\n**Act three.** She runs back across the sand against the turning tide, finds him, and the two of them wade home as the channel fills — not speaking, holding on.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmpreproduction-c4"},{"id":"filmpreproduction-c7","type":"table","x":56,"y":870,"w":298,"h":312,"title":"Key facts","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Format","Detail"],["Runtime","12 min"],["Shoot","4 days, 2 locations"],["Camera","Super 35, 2.39:1"],["Script","Draft 7 — locked"],["Delivery","Festival DCP + ProRes 4444"]],"sectionId":"filmpreproduction-c4"},{"id":"filmpreproduction-c8","type":"file","x":56,"y":1198,"w":298,"h":135,"title":"Shooting script","body":"Locked draft. Scene numbers are final; revisions go on coloured pages.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"LowTide_ShootingScript_v7.pdf","boardId":null,"sectionId":"filmpreproduction-c4"},{"id":"filmpreproduction-ca","type":"image","x":426,"y":343,"w":298,"h":219,"title":"Reference — the flats at dawn","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:ph-film-tidal-flats","filename":"ph-film-tidal-flats.jpg","boardId":null,"sectionId":"filmpreproduction-c9"},{"id":"filmpreproduction-cb","type":"image","x":426,"y":578,"w":298,"h":237,"title":"Reference — the fog arrives","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:ph-film-sea-fog","filename":"ph-film-sea-fog.jpg","boardId":null,"sectionId":"filmpreproduction-c9"},{"id":"filmpreproduction-cc","type":"image","x":426,"y":831,"w":298,"h":189,"title":"Palette — wet sand to storm grey","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:gen-palette-586823ed64","filename":"gen-palette-586823ed64.png","boardId":null,"sectionId":"filmpreproduction-c9"},{"id":"filmpreproduction-cd","type":"note","x":426,"y":1036,"w":298,"h":214,"title":"Visual rules","body":"- Handheld only when Mara is moving; locked off when she is still.\n- Horizon always in frame on the flats — the audience must read the distance.\n- Her orange coat is the only saturated colour in the film.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmpreproduction-c9"},{"id":"filmpreproduction-cf","type":"table","x":796,"y":343,"w":298,"h":383,"title":"Key crew","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Role","Name","Status"],["Director","Ana Ruiz","Confirmed"],["Producer","Tom Okafor","Confirmed"],["DP","Lea Brandt","Confirmed"],["Production designer","Sam Hale","Pencilled"],["Sound recordist","Iris Mendes","Searching"],["Editor","Joon Park","Confirmed"]],"sectionId":"filmpreproduction-ce"},{"id":"filmpreproduction-cg","type":"board","x":796,"y":742,"w":298,"h":200,"title":"Casting","body":"Shortlists, self-tapes and chemistry-read notes for Mara and Ted.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":"filmpreproduction-bh","sectionId":"filmpreproduction-ce"},{"id":"filmpreproduction-cw","type":"task","x":796,"y":958,"w":298,"h":252,"title":"Before we lock the team","body":"","color":"paper","tags":[],"comments":[],"items":[{"id":"filmpreproduction-ix","text":"Director and producer attached","done":true},{"id":"filmpreproduction-iy","text":"DP confirmed","done":true},{"id":"filmpreproduction-iz","text":"Sound recordist with marine experience","done":false},{"id":"filmpreproduction-i10","text":"Water-safety officer for the flats","done":false},{"id":"filmpreproduction-i11","text":"Runner with a full licence","done":false}],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmpreproduction-ce"},{"id":"filmpreproduction-c13","type":"image","x":1166,"y":343,"w":298,"h":237,"title":"Location 1 — the sea wall","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:ph-film-sea-wall","filename":"ph-film-sea-wall.jpg","boardId":null,"sectionId":"filmpreproduction-c12"},{"id":"filmpreproduction-c14","type":"note","x":1166,"y":596,"w":298,"h":147,"title":"Location 1 — the sea wall","body":"Car park at the north end for unit base. Power from the café by arrangement. Public footpath: we need two marshals to hold walkers for takes.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmpreproduction-c12"},{"id":"filmpreproduction-c15","type":"image","x":1166,"y":759,"w":298,"h":237,"title":"Location 2 — the sandbanks","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:ph-film-sandbank","filename":"ph-film-sandbank.jpg","boardId":null,"sectionId":"filmpreproduction-c12"},{"id":"filmpreproduction-c16","type":"note","x":1166,"y":1012,"w":298,"h":147,"title":"Location 2 — the sandbanks","body":"Only safe 2 h either side of low water. Tide tables decide the call times on days 2–4. Harbour master must approve the safety plan.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmpreproduction-c12"},{"id":"filmpreproduction-c17","type":"link","x":1166,"y":1175,"w":298,"h":157,"title":"Tide tables for the shoot week","body":"Check spring/neap: we want a spring low on days 2 and 3.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://www.tidetimes.co.uk","media":"","filename":"","boardId":null,"sectionId":"filmpreproduction-c12"},{"id":"filmpreproduction-c19","type":"table","x":1536,"y":343,"w":408,"h":591,"title":"Top sheet","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Line","Budget","Notes"],["Cast","£2,800","2 leads, 4 days + rehearsal"],["Crew","£6,900","12 crew, 4 days"],["Camera & grip","£2,600","Package deal, incl. 2 drone hours"],["Locations & permits","£1,100","Council, harbour, café"],["Art & wardrobe","£900","Two coats — one hero, one wet"],["Safety & insurance","£1,450","Water-safety team + PL"],["Catering & travel","£1,250",""],["Post","£1,400","Grade, mix, DCP"],["Contingency (10%)","£1,700","Hold until picture lock"],["Total","£18,400",""]],"sectionId":"filmpreproduction-c18"},{"id":"filmpreproduction-c1a","type":"note","x":1536,"y":950,"w":408,"h":127,"title":"Money rules","body":"Spend contingency only with the producer’s sign-off. Anything over £250 gets a quote on the board before it is booked.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmpreproduction-c18"},{"id":"filmpreproduction-c1c","type":"note","x":2016,"y":343,"w":268,"h":147,"title":"Tide and fog","body":"Real fog cannot be scheduled. Plan B is a smoke machine on the sea wall and a grade pass; decide on the morning by 06:00.","color":"rose","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmpreproduction-c1b"},{"id":"filmpreproduction-c1d","type":"note","x":2016,"y":506,"w":268,"h":127,"title":"Working in water","body":"Nobody goes deeper than the waist. Safety boat on standby for every take on the sandbanks.","color":"rose","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmpreproduction-c1b"},{"id":"filmpreproduction-c1e","type":"note","x":2016,"y":649,"w":268,"h":127,"title":"Minor on set","body":"Chaperone at all times; hours limited by licence. Night pickups are not possible with our lead.","color":"rose","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmpreproduction-c1b"},{"id":"filmpreproduction-c1f","type":"timeline","x":40,"y":1405,"w":2160,"h":442,"title":"Eight weeks to the first shoot day","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"timeline":{"mode":"date","fps":[24,1],"drop":false,"start":20458,"end":20514,"links":false,"items":[{"id":"filmpreproduction-t2b","card":"filmpreproduction-c1h","at":20458,"len":14,"lane":0},{"id":"filmpreproduction-t2c","card":"filmpreproduction-c1n","at":20465,"len":16,"lane":1},{"id":"filmpreproduction-t2d","card":"filmpreproduction-c1t","at":20472,"len":14,"lane":2},{"id":"filmpreproduction-t2e","card":"filmpreproduction-c1z","at":20479,"len":21,"lane":0},{"id":"filmpreproduction-t2f","card":"filmpreproduction-c24","at":20500,"len":7,"lane":1},{"id":"filmpreproduction-t2g","card":"filmpreproduction-c28","at":20471,"len":3,"lane":3},{"id":"filmpreproduction-t2h","card":"filmpreproduction-c29","at":20492,"len":3,"lane":3},{"id":"filmpreproduction-t2i","card":"filmpreproduction-c2a","at":20510,"len":4,"lane":2}]}},{"id":"filmpreproduction-c1h","type":"task","x":56,"y":1950,"w":368,"h":204,"title":"Development","body":"","color":"paper","tags":[],"comments":[],"items":[{"id":"filmpreproduction-i1i","text":"Script locked (draft 7)","done":true},{"id":"filmpreproduction-i1j","text":"Director’s statement","done":true},{"id":"filmpreproduction-i1k","text":"Lookbook for funders","done":false},{"id":"filmpreproduction-i1l","text":"Final budget sign-off","done":false}],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmpreproduction-c1g"},{"id":"filmpreproduction-c1n","type":"task","x":496,"y":1950,"w":368,"h":204,"title":"Casting","body":"","color":"paper","tags":[],"comments":[],"items":[{"id":"filmpreproduction-i1o","text":"Breakdown released","done":true},{"id":"filmpreproduction-i1p","text":"Self-tapes in","done":true},{"id":"filmpreproduction-i1q","text":"Chemistry read","done":false},{"id":"filmpreproduction-i1r","text":"Offers out and accepted","done":false}],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmpreproduction-c1m"},{"id":"filmpreproduction-c1t","type":"task","x":936,"y":1950,"w":368,"h":204,"title":"Locations","body":"","color":"paper","tags":[],"comments":[],"items":[{"id":"filmpreproduction-i1u","text":"Shortlist of 3 sea walls","done":true},{"id":"filmpreproduction-i1v","text":"Tide study on the flats","done":false},{"id":"filmpreproduction-i1w","text":"Permits: council, harbour","done":false},{"id":"filmpreproduction-i1x","text":"Unit base and parking plan","done":false}],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmpreproduction-c1s"},{"id":"filmpreproduction-c1z","type":"task","x":1376,"y":1950,"w":368,"h":175,"title":"Art & wardrobe","body":"","color":"paper","tags":[],"comments":[],"items":[{"id":"filmpreproduction-i20","text":"Coat tests on camera","done":false},{"id":"filmpreproduction-i21","text":"Props: cockle rake, radio, bucket","done":false},{"id":"filmpreproduction-i22","text":"Ted’s boat shed dressing","done":false}],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmpreproduction-c1y"},{"id":"filmpreproduction-c24","type":"task","x":1816,"y":1950,"w":368,"h":175,"title":"Rehearsals","body":"","color":"paper","tags":[],"comments":[],"items":[{"id":"filmpreproduction-i25","text":"Table read","done":false},{"id":"filmpreproduction-i26","text":"Blocking on the sea wall","done":false},{"id":"filmpreproduction-i27","text":"Water drill with safety team","done":false}],"url":"","media":"","filename":"","boardId":null,"sectionId":"filmpreproduction-c23"},{"id":"filmpreproduction-c28","type":"note","x":1816,"y":2141,"w":368,"h":107,"title":"Script lock","body":"Draft 7 frozen. Changes after this point are coloured pages.","color":"sage","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":n