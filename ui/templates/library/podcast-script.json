-c5","at":0,"len":1500,"lane":0},{"id":"podcastscript-tj","card":"podcastscript-c6","at":1500,"len":1500,"lane":1},{"id":"podcastscript-tk","card":"podcastscript-c7","at":3000,"len":27000,"lane":0},{"id":"podcastscript-tl","card":"podcastscript-c8","at":30000,"len":1500,"lane":2},{"id":"podcastscript-tm","card":"podcastscript-c9","at":31500,"len":12000,"lane":0},{"id":"podcastscript-tn","card":"podcastscript-ca","at":43500,"len":9000,"lane":0},{"id":"podcastscript-to","card":"podcastscript-cb","at":52500,"len":2250,"lane":1}]}},{"id":"podcastscript-c5","type":"note","x":40,"y":708,"w":270,"h":127,"title":"Cold open","body":"SFX: dome motors. GUEST: “The first ten minutes, you just stand there and let your eyes get used to it.”","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"podcastscript-c6","type":"note","x":328,"y":708,"w":270,"h":107,"title":"Theme + intro","body":"MUSIC: theme, 20 s. HOST intro over the bed.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"podcastscript-c7","type":"note","x":616,"y":708,"w":270,"h":127,"title":"Segment 1 — the shift","body":"Interview. Mark the clean answer about the telescope at ~12 min for the trailer.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"podcastscript-c8","type":"note","x":904,"y":708,"w":270,"h":107,"title":"Mid-roll","body":"HOST read: newsletter + listener note.","color":"rose","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"podcastscript-c9","type":"note","x":1192,"y":708,"w":270,"h":107,"title":"Segment 2 — 3 a.m.","body":"Interview. Under the ghost story: drop music out completely.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"podcastscript-ca","type":"note","x":1480,"y":708,"w":270,"h":87,"title":"Segment 3 — daylight","body":"Interview, ends on her advice.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"podcastscript-cb","type":"note","x":1768,"y":708,"w":270,"h":107,"title":"Outro","body":"MUSIC: theme. HOST: thanks, next week, review ask.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"podcastscript-cd","type":"note","x":56,"y":938,"w":608,"h":147,"title":"HOST","body":"Tonight on Small Hours: someone whose working day starts when the sun goes down. She has spent eleven winters on a mountain, waiting for clouds to move, listening to a telescope think. She’s seen satellites die and stars be born — or at least, the light from them. Let’s go up the mountain.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"podcastscript-cc"},{"id":"podcastscript-cf","type":"table","x":736,"y":938,"w":608,"h":260,"title":"Cues","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Time","Cue","Note"],["00:00","SFX dome motors","From the guest’s recording"],["01:00","Theme in","20 s, then under"],["21:00","Bed out","Silence under the story"],["35:00","Theme","Full to the end"]],"sectionId":"podcastscript-ce"},{"id":"podcastscript-ch","type":"note","x":1416,"y":938,"w":568,"h":107,"title":"Loudness","body":"−16 LUFS integrated, −1 dBTP. Interview levelled; room tone filled between answers.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"podcastscript-cg"}],"edges":[],"view":{"x":60,"y":50,"zoom":0.8},"updated":0,"template":{"id":"lib-podcast-script","version":"1.0.0"}}]}