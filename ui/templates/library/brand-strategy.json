:40,"y":40,"w":1180,"h":67,"title":"Brand strategy — Fernhill Dental","body":"The strategy on one page. Everything the identity, website and staff training will be built on.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"brandstrategy-c3","type":"sticky","x":1260,"y":40,"w":380,"h":200,"title":"How to use this template","body":"Read top to bottom: why we exist, what we stand for, who for, what we promise and how we sound. Each card should be short enough to remember.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"brandstrategy-c5","type":"note","x":56,"y":335,"w":328,"h":107,"title":"Why we exist","body":"To make sure no one avoids the dentist because they are afraid.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandstrategy-c4"},{"id":"brandstrategy-c7","type":"note","x":456,"y":335,"w":328,"h":107,"title":"Where we’re going","body":"A town where people book a check-up as easily as a haircut.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandstrategy-c6"},{"id":"brandstrategy-c9","type":"note","x":856,"y":335,"w":328,"h":147,"title":"Statement","body":"For anxious adults who avoid the dentist, Fernhill is the practice that puts you in control — because every step is explained and you can always stop.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandstrategy-c8"},{"id":"brandstrategy-cb","type":"note","x":1256,"y":335,"w":328,"h":87,"title":"Honesty","body":"Prices up front, plain answers.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandstrategy-ca"},{"id":"brandstrategy-cc","type":"note","x":1256,"y":438,"w":328,"h":87,"title":"Patience","body":"Nobody is rushed.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandstrategy-ca"},{"id":"brandstrategy-cd","type":"note","x":1256,"y":541,"w":328,"h":87,"title":"Control","body":"The patient decides the pace.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandstrategy-ca"},{"id":"brandstrategy-cf","type":"note","x":1656,"y":335,"w":328,"h":87,"title":"Promise","body":"**Dentistry that puts you in charge.**","color":"sage","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandstrategy-ce"},{"id":"brandstrategy-cg","type":"note","x":1656,"y":438,"w":328,"h":107,"title":"Proof","body":"Stop signal in every chair · prices online · 30-minute first visits with no treatment","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandstrategy-ce"},{"id":"brandstrategy-ci","type":"note","x":56,"y":755,"w":528,"h":87,"title":"Traits","body":"Calm · straight-talking · kind · quietly confident","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandstrategy-ch"},{"id":"brandstrategy-ck","type":"note","x":656,"y":755,"w":588,"h":147,"title":"Story","body":"Most people who avoid the dentist aren’t afraid of pain — they’re afraid of not knowing what’s coming. So at Fernhill, you’ll always know. We explain before we act, we show you the price before you agree, and you can stop us at any time. Your mouth, your pace.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandstrategy-cj"},{"id":"brandstrategy-cm","type":"table","x":1316,"y":755,"w":528,"h":208,"title":"Priority","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Audience","Need"],["Anxious adults","Control"],["Families","Ease, child-friendly"],["Staff","Pride, clarity"]],"sectionId":"brandstrategy-cl"}],"edges":[],"view":{"x":60,"y":50,"zoom":0.8},"updated":0,"template":{"id":"lib-brand-strategy","version":"1.0.0"}}]}