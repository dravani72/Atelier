,"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"gamedesigndocument-c7"},{"id":"gamedesigndocument-c9","type":"note","x":456,"y":458,"w":308,"h":107,"title":"2 · Every island has a story","body":"Each island has one character and one secret.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"gamedesigndocument-c7"},{"id":"gamedesigndocument-ca","type":"note","x":456,"y":581,"w":308,"h":107,"title":"3 · Never punish curiosity","body":"No fail states, no timers, no lost progress.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"gamedesigndocument-c7"},{"id":"gamedesigndocument-cc","type":"sketch","x":836,"y":335,"w":348,"h":266,"title":"Core loop","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:gen-sketch-e87b89a83e","filename":"gen-sketch-e87b89a83e.png","boardId":null,"sectionId":"gamedesigndocument-cb"},{"id":"gamedesigndocument-cd","type":"note","x":836,"y":617,"w":348,"h":107,"title":"Session","body":"15–20 minute sessions; each island is one sitting.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"gamedesigndocument-cb"},{"id":"gamedesigndocument-cf","type":"table","x":1256,"y":335,"w":328,"h":350,"title":"Systems","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Mechanic","Notes"],["Tide clock","3 heights: low, mid, high"],["Floating","Crates, logs, boats rise with water"],["Paths","Sandbars appear at low tide"],["Creatures","Crabs move with the tide"],["Journal","Auto-logs clues"]],"sectionId":"gamedesigndocument-ce"},{"id":"gamedesigndocument-ch","type":"image","x":1656,"y":335,"w":328,"h":302,"title":"Island 1","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:ph-gm-island","filename":"ph-gm-island.jpg",