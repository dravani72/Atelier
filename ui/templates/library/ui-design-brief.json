{"format":"atelier-package","version":1,"name":"UI design brief","generator":"Atelier template library","boards":[{"id":"uidesignbrief-b1","name":"UI design brief","parent":null,"description":"Brief interface design: objectives, users, screens, components, interaction and style references, accessibility and handoff.","color":"theme","cards":[{"id":"uidesignbrief-c4","type":"column","x":40,"y":280,"w":360,"h":501,"title":"The project","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"uidesignbrief-c7","type":"column","x":440,"y":280,"w":360,"h":449,"title":"Goals","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"uidesignbrief-ca","type":"column","x":840,"y":280,"w":360,"h":609,"title":"Audience","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"uidesignbrief-ce","type":"column","x":1240,"y":280,"w":360,"h":529,"title":"What to say","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"uidesignbrief-cm","type":"column","x":1640,"y":280,"w":360,"h":640,"title":"References","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"uidesignbrief-cq","type":"column","x":40,"y":1396,"w":620,"h":353,"title":"Deliverables","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"uidesignbrief-cs","type":"column","x":700,"y":1396,"w":600,"h":439,"title":"Milestones","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"uidesignbrief-c10","type":"column","x":1340,"y":1396,"w":340,"h":186,"title":"Budget","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"uidesignbrief-c12","type":"column","x":1720,"y":1396,"w":320,"h":254,"title":"Approvals","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"uidesignbrief-c2","type":"heading","x":40,"y":40,"w":1180,"h":67,"title":"UI brief — field inspection tablet app","body":"A fictional app for building inspectors to record defects on site. Used outdoors, in gloves, often in poor signal.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"uidesignbrief-c3","type":"sticky","x":1260,"y":40,"w":380,"h":200,"title":"How to use this template","body":"Fill the brief together with the client in one session, then lock it. Anything not on this board is not in scope. When something changes, change the card and note the date in a comment.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"uidesignbrief-c5","type":"note","x":56,"y":335,"w":328,"h":127,"title":"Background","body":"Inspectors use paper forms and photos, then retype everything at the office. The new app must be faster than paper on day one.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"uidesignbrief-c4"},{"id":"uidesignbrief-c6","type":"table","x":56,"y":478,"w":328,"h":279,"title":"At a glance","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Item","Detail"],["Product","Inspection app (fictional)"],["Device","10\" tablet, landscape"],["Users","45 inspectors"],["Screens","~14"]],"sectionId":"uidesignbrief-c4"},{"id":"uidesignbrief-c8","type":"note","x":456,"y":335,"w":328,"h":127,"title":"Objective","body":"Let an inspector log a defect with photo, location and severity in under 30 seconds, offline.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"uidesignbrief-c7"},{"id":"uidesignbrief-c9","type":"table","x":456,"y":478,"w":328,"h":227,"title":"How we’ll measure it","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Measure","Target"],["Time per defect","< 30 s"],["Errors in reports","−50%"],["Adoption at 1 month","90%"]],"sectionId":"uidesignbrief-c7"},{"id":"uidesignbrief-cb","type":"note","x":856,"y":335,"w":328,"h":107,"title":"Who","body":"Inspectors aged 30–64, varied tech confidence, working in rain, glare and gloves.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"uidesignbrief-ca"},{"id":"uidesignbrief-cc","type":"note","x":856,"y":458,"w":328,"h":107,"title":"Insight","body":"Speed beats features: anything that needs two hands or reading glasses will be skipped.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"uidesignbrief-ca"},{"id":"uidesignbrief-cd","type":"image","x":856,"y":581,"w":328,"h":284,"title":"Context of use","body":"Photo: NRC Resident Inspector at the Summer New Reactor Construction Site - August 2012 (7797524972) — Nuclear Regulatory Commission from US. Public domain, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:NRC_Resident_Inspector_at_the_Summer_New_Reactor_Construction_Site_-_August_2012_(7797524972).jpg","media":"@image:ph-ui-inspector","filename":"ph-ui-inspector.jpg","boardId":null,"sectionId":"uidesignbrief-ca"},{"id":"uidesignbrief-cf","type":"note","x":1256,"y":335,"w":328,"h":127,"title":"Key message","body":"Design principles: big targets (min 56 px), high contrast, one action per screen, works offline, nothing is ever lost.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"uidesignbrief-ce"},{"id":"uidesignbrief-cg","type":"note","x":1256,"y":478,"w":328,"h":87,"title":"Tone","body":"Utilitarian, calm, confident.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"uidesignbrief-ce"},{"id":"uidesignbrief-ch","type":"task","x":1256,"y":581,"w":328,"h":204,"title":"Mandatories","body":"","color":"paper","tags":[],"comments":[],"items":[{"id":"uidesignbrief-ii","text":"WCAG AA contrast outdoors (aim AAA)","done":false},{"id":"uidesignbrief-ij","text":"Offline-first","done":false},{"id":"uidesignbrief-ik","text":"Dark mode for basements","done":false},{"id":"uidesignbrief-il","text":"Glove-friendly targets","done":false}],"url":"","media":"","filename":"","boardId":null,"sectionId":"uidesignbrief-ce"},{"id":"uidesignbrief-cn","type":"image","x":1656,"y":335,"w":328,"h":259,"title":"Glare","body":"Photo: An Essex Dementia Care visitor using a tablet computer given by WaveLength charity. — WaveLength Charity. CC BY-SA 4.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:An_Essex_Dementia_Care_visitor_using_a_tablet_computer_given_by_WaveLength_charity..jpg","media":"@image:ph-ui-tablet-outdoors","filename":"ph-ui-tablet-outdoors.jpg","boardId":null,"sectionId":"uidesignbrief-cm"},{"id":"uidesignbrief-co","type":"image","x":1656,"y":610,"w":328,"h":286,"title":"What they record","body":"Photo: Concrete wall cracking as steel reinforcing corrodes and swells 9058 — JonRichfield. CC BY-SA 3.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Concrete_wall_cracking_as_steel_reinforcing_corrodes_and_swells_9058.jpg","media":"@image:ph-ui-defect","filename":"ph-ui-defect.jpg","boardId":null,"sectionId":"uidesignbrief-cm"},{"id":"uidesignbrief-cp","type":"timeline","x":40,"y":968,"w":1960,"h":380,"title":"Schedule","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":n