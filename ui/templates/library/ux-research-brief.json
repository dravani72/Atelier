-c10","type":"column","x":1720,"y":1396,"w":320,"h":254,"title":"Approvals","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"uxresearchbrief-c2","type":"heading","x":40,"y":40,"w":1180,"h":67,"title":"Research brief — checkout drop-off","body":"A fictional online furniture shop loses 68% of shoppers between basket and payment. Why?","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"uxresearchbrief-c3","type":"sticky","x":1260,"y":40,"w":380,"h":200,"title":"How to use this template","body":"Fill the brief together with the client in one session, then lock it. Anything not on this board is not in scope. When something changes, change the card and note the date in a comment.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"uxresearchbrief-c5","type":"note","x":56,"y":335,"w":328,"h":147,"title":"Background","body":"Analytics show the drop happens on the delivery step. Customer service hears complaints about delivery slots and costs “appearing late”.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"uxresearchbrief-c4"},{"id":"uxresearchbrief-c6","type":"table","x":56,"y":498,"w":328,"h":279,"title":"At a glance","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Item","Detail"],["Product","Online furniture shop"],["Method","Interviews + usability tests"],["Participants","10"],["Duration","3 weeks"]],"sectionId":"uxresearchbrief-c4"},{"id":"uxresearchbrief-c8","type":"note","x":456,"y":335,"w":328,"h":127,"title":"Objective","body":"Understand why shoppers abandon at delivery, and identify the three changes most likely to fix it.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"uxresearchbrief-c7"},{"id":"uxresearchbrief-c9","type":"table","x":456,"y":478,"w":328,"h":227,"title":"How we’ll measure it","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Measure","Target"],["Sessions completed","10"],["Top issues with evidence","3+"],["Decision made by","Week 4"]],"sectionId":"uxresearchbrief-c7"},{"id":"uxresearchbrief-cb","type":"note","x":856,"y":335,"w":328,"h":107,"title":"Who","body":"People who bought — or nearly bought — a sofa or bed online in the last 6 months.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"uxresearchbrief-ca"},{"id":"uxresearchbrief-cc","type":"image","x":856,"y":458,"w":328,"h":258,"title":"Method","body":"Photo: A group of female students looking on a laptop 01 — Kwameghana(Bright Kwame Ayisi). CC0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:A_group_of_female_students_looking_on_a_laptop_01.jpg","media":"@image:ph-ux-usability-test","filename":"ph-ux-usability-test.jpg","boardId":null,"sectionId":"uxresearchbrief-ca"},{"id":"uxresearchbrief-ce","type":"note","x":1256,"y":335,"w":328,"h":127,"title":"Key message","body":"Research questions: What do shoppers expect to know about delivery, and when? What makes them leave? What would make them finish?","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"uxresearchbrief-cd"},{"id":"uxresearchbrief-cf","type":"note","x":1256,"y":478,"w":328,"h":107,"title":"Tone","body":"Neutral, non-leading. We are testing the site, not the people.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"uxresearchbrief-cd"},{"id":"uxresearchbrief-cg","type":"task","x":1256,"y":601,"w":328,"h":204,"title":"Mandatories","body":"","color":"paper","tags":[],"comments":[],"ite