":"","filename":"","boardId":null},{"id":"advertisingbrief-c14","type":"column","x":1720,"y":1513,"w":320,"h":283,"title":"Approvals","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"advertisingbrief-c2","type":"heading","x":40,"y":40,"w":1180,"h":67,"title":"Ad brief — Brightwell Bikes “Ride to work”","body":"A fictional e-bike brand wants commuters to swap one car journey a week for a bike. National campaign, spring launch.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"advertisingbrief-c3","type":"sticky","x":1260,"y":40,"w":380,"h":200,"title":"How to use this template","body":"Fill the brief together with the client in one session, then lock it. Anything not on this board is not in scope. When something changes, change the card and note the date in a comment.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"advertisingbrief-c5","type":"note","x":56,"y":335,"w":328,"h":147,"title":"Background","body":"Brightwell sells mid-priced e-bikes online. Awareness is high among cyclists and near zero among drivers — the people who would gain most.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"advertisingbrief-c4"},{"id":"advertisingbrief-c6","type":"table","x":56,"y":498,"w":328,"h":298,"title":"At a glance","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Item","Detail"],["Client","Brightwell Bikes (fictional)"],["Budget","£420k working media + £90k production"],["Markets","UK, 6 cities"],["Launch","Week 9"]],"sectionId":"advertisingbrief-c4"},{"id":"advertisingbrief-c8","type":"note","x":456,"y":335,"w":328,"h":107,"title":"Objective","body":"Get 25–45-year-old car commuters in six cities to book a free two-week trial.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"advertisingbrief-c7"},{"id":"advertisingbrief-c9","type":"table","x":456,"y":458,"w":328,"h":227,"title":"How we’ll measure it","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Measure","Target"],["Trial bookings","6,000"],["Consideration (drivers)","+8 pts"],["Cost per booking","< £70"]],"sectionId":"advertisingbrief-c7"},{"id":"advertisingbrief-cb","type":"note","x":856,"y":335,"w":328,"h":127,"title":"Who","body":"Car commuters, 5–15 km each way, who say they would cycle “if it weren’t for hills, sweat and rain”.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"advertisingbrief-ca"},{"id":"advertisingbrief-cc","type":"note","x":856,"y":478,"w":328,"h":107,"title":"Insight","body":"People don’t hate cycling; they hate arriving at work looking like they cycled.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"advertisingbrief-ca"},{"id":"advertisingbrief-cd","type":"image","x":856,"y":601,"w":328,"h":286,"title":"The audience — cyclists in work clothes","body":"Photo: Cyclist-189 — ProfDEH. CC BY-SA 3.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Cyclist-189.JPG","media":"@image:ph-ad-commuter-bike","filename":"ph-ad-commuter-bike.jpg","boardId":null,"sectionId":"advertisingbrief-ca"},{"id":"advertisingbrief-cf","type":"note","x":1256,"y":335,"w":328,"h":107,"title":"Key message","body":"Arrive fresh, not flustered — Brightwell does the hard part.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"advertisingbrief-ce"},{"id":"advertisingbrief-cg","type":"note","x":1256,"y":458,"w":328,"h":107,"title":"Tone","body":"Witty, warm, a bit smug about the traffic. Never preachy about the planet.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"advertisingbrief-ce"},{"id":"advertisingbrief-ch","type":"task","x":1256,"y":581,"w":328,"h":204,"title":"Mandatories","body":"","color":"paper","tags":[],"comments":[],"items":[{"id":"advertisingbrief-ii","text":"Free 2-week trial offer","done":false},{"id":"advertisingbrief-ij","text":"Logo + URL in every execution","done":false},{"id":"advertisingbrief-ik","text":"Rider wearing a helmet","done":false},{"id":"advertisingbrief-il","text":"No pricing in OOH","done":false}],"url":"","media":"","filename":"","boardId":null,"sectionId":"advertisingbrief-ce"},{"id":"advertisingbrief-cn","type":"image","x":1656,"y":335,"w":328,"h":259,"title":"The enemy: traffic","body":"Photo: Traffic jam Sao Paulo 09 2006 30a — Mario Roberto Duran Ortiz Mariordo. CC BY 3.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Traffic_jam_Sao_Paulo_09_2006_30a.jpg","media":"@image:ph-ad-traffic","filename":"ph-ad-traffic.jpg","boardId":null,"sectionId":"advertisingbrief-cm"},{"id":"advertisingbrief-co","type":"image","x":1656,"y":610,"w":328,"h":260,"title":"The promise: the empty lane","body":"Photo: Protected Bike Lane Tempelhofer Damm — Nakaner. CC BY 4.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Protected_Bike_Lane_Tempelhofer_Damm.jpg","media":"@image:ph-ad-cycle-lane","filename":"ph-ad-cycle-lane.jpg","boardId":null,"sectionId":"advertisingbrief-cm"},{"id":"advertisingbrief-cp","type":"note","x":1656,"y":886,"w":328,"h":127,"title":"What to take from them","body":"Contrast the stuck car with the moving bike — but make the driver the hero who chose differently, not the villain.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"se