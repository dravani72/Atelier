,"url":"","media":"","filename":"","boardId":null,"sectionId":"mediaplanningbrief-c7"},{"id":"mediaplanningbrief-c9","type":"table","x":456,"y":458,"w":328,"h":208,"title":"How we’ll measure it","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Measure","Target"],["Sign-ups","2,500"],["Cost per sign-up","< £24"],["Reach in postcodes","60% of households"]],"sectionId":"mediaplanningbrief-c7"},{"id":"mediaplanningbrief-cb","type":"note","x":856,"y":335,"w":328,"h":127,"title":"Who","body":"Homeowners 30–65 with gardens and families, in specific postcodes. Bin day is the trigger moment.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"mediaplanningbrief-ca"},{"id":"mediaplanningbrief-cc","type":"note","x":856,"y":478,"w":328,"h":127,"title":"Insight","body":"People only think about their bins on bin day — usually in the evening when they put them out.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"mediaplanningbrief-ca"},{"id":"mediaplanningbrief-cd","type":"image","x":856,"y":621,"w":328,"h":256,"title":"The moment: bin day","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:ph-mp-wheelie-bins","filename":"ph-mp-wheelie-bins.jpg","boardId":null,"sectionId":"mediaplanningbrief-ca"},{"id":"mediaplanningbrief-cf","type":"note","x":1256,"y":335,"w":328,"h":107,"title":"Key message","body":"A clean bin every fortnight, without lifting a finger.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"mediaplanningbrief-ce"},{"id":"mediaplanningbrief-cg","type":"note","x":1256,"y":458,"w":328,"h":87,"title":"Tone","body":"Practical, cheeky, neighbourly.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"mediaplanningbrief-ce"