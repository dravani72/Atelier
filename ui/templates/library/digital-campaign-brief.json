":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"digitalcampaignbrief-c7"},{"id":"digitalcampaignbrief-c9","type":"table","x":456,"y":458,"w":328,"h":260,"title":"How we’ll measure it","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Measure","Target"],["Installs","40,000"],["First bookings","8,000"],["Cost per first booking","< £18"],["Day-30 retention","35%"]],"sectionId":"digitalcampaignbrief-c7"},{"id":"digitalcampaignbrief-cb","type":"note","x":856,"y":335,"w":328,"h":107,"title":"Who","body":"Renters aged 22–38 who have a dripping tap and a landlord who won’t reply.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"digitalcampaignbrief-ca"},{"id":"digitalcampaignbrief-cc","type":"note","x":856,"y":458,"w":328,"h":127,"title":"Insight","body":"Renters fix nothing because they don’t trust strangers in their home — and don’t know what a fair price is.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"digitalcampaignbrief-ca"},{"id":"digitalcampaignbrief-cd","type":"image","x":856,"y":601,"w":328,"h":259,"title":"The renter","body":"Photo: Young business woman with curly hair in uniform using smartphone at home. (51487906519) — Nenad Stojkovic. CC BY 2.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Young_business_woman_with_curly_hair_in_uniform_using_smartphone_at_home._(51487906519).jpg","media":"@image:ph-dc-renter-phone","filename":"ph-dc-renter-phone.jpg","boardId":null,"sectionId":"digitalcampaignbrief-ca"},{"id":"digitalcampaignbrief-cf","type":"note","x":1256,"y":335,"w":328,"h":87,"title":"Key message","body":"Fixed today, fair price, vetted pros.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":