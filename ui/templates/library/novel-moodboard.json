{"format":"atelier-package","version":1,"name":"Novel moodboard","generator":"Atelier template library","boards":[{"id":"novelmoodboard-b1","name":"Novel moodboard","parent":null,"description":"Capture a book’s atmosphere — places, light, textures, objects, faces and music — to return to whenever the draft loses its voice.","color":"theme","cards":[{"id":"novelmoodboard-ca","type":"column","x":1012,"y":280,"w":360,"h":345,"title":"Words","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"novelmoodboard-cd","type":"column","x":1412,"y":280,"w":360,"h":548,"title":"Palette & sound","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"novelmoodboard-c2","type":"heading","x":40,"y":40,"w":1180,"h":67,"title":"The Glass Orchard — mood","body":"Salt, heat, glass, rain. A book that smells of wet wool and hot metal.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"novelmoodboard-c3","type":"sticky","x":1260,"y":40,"w":380,"h":200,"title":"How to use this template","body":"Collect freely; prune often. Write one sentence under each image about why it belongs. Open this board before every writing session for two minutes.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"novelmoodboard-c4","type":"image","x":40,"y":280,"w":300,"h":240,"title":"The crossing","body":"Photo: Rain at Sea-1149, Tralee Bay, Co. Kerry, Ireland — Maoileann. CC BY-SA 4.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Rain_at_Sea-1149,_Tralee_Bay,_Co._Kerry,_Ireland.jpg","media":"@image:ph-wri-mood-sea-rain","filename":"ph-wri-mood-sea-rain.jpg","boardId":null},{"id":"novelmoodboard-c5","type":"image","x":356,"y":280,"w":300,"h":269,"title":"The furnace","body":"Photo: Mr Tony Kuepfer,