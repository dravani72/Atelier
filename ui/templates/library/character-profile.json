{"format":"atelier-package","version":1,"name":"Character profile","generator":"Atelier template library","boards":[{"id":"characterprofile-b1","name":"Character profile","parent":null,"description":"Build a character from the inside out: want and need, wound, voice, habits, look, relationships and how they change.","color":"theme","cards":[{"id":"characterprofile-c4","type":"column","x":40,"y":280,"w":320,"h":802,"title":"Basics","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"characterprofile-c7","type":"column","x":400,"y":280,"w":360,"h":595,"title":"Inside","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"characterprofile-cc","type":"column","x":800,"y":280,"w":360,"h":377,"title":"Voice & habits","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"characterprofile-cf","type":"column","x":1200,"y":280,"w":360,"h":392,"title":"Relationships","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"characterprofile-cj","type":"column","x":1600,"y":280,"w":360,"h":622,"title":"Arc","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"characterprofile-c2","type":"heading","x":40,"y":40,"w":1180,"h":67,"title":"Character — Ines Varga","body":"Protagonist. Close third person throughout, so we need to know how she thinks, not just what she does.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"characterprofile-c3","type":"sticky","x":1260,"y":40,"w":380,"h":200,"title":"How to use this template","body":"Start with want, need and wound — they drive everything else. Add a line of her dialogue for voice. Update the arc card when the outline changes.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"characterprofile-c5","type":"image","x":56,"y":335,"w":288,"h":371,"title":"Casting reference","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:ph-wri-portrait-woman","filename":"ph-wri-portrait-woman.jpg","boardId":null,"sectionId":"characterprofile-c4"},{"id":"characterprofile-c6","type":"table","x":56,"y":722,"w":288,"h":336,"title":"Facts","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Item","Detail"],["Age","34"],["Lives","A rented flat on the mainland"],["Work","Glass designer for a lighting firm"],["Family","Brother Tomas; grandmother Zsófia (dies ch. 1)"]],"sectionId":"characterprofile-c4"},{"id":"characterprofile-c8","type":"note","x":416,"y":335,"w":328,"h":107,"title":"Want","body":"To bury Zsófia, sell her share and leave on the Sunday ferry.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"characterprofile-c7"},{"id":"characterprofile-c9","type":"note","x":416,"y":458,"w":328,"h":127,"title":"Need","body":"To forgive herself for leaving — and to make something with her hands that isn’t for sale.","color":"sage","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"characterprofile-c7"},{"id":"characterprofile-ca","type":"note","x":416,"y":601,"w":328,"h":127,"title":"Wound","body":"Her mother drowned when she was 12. Ines left the island at 18 and told everyone it was for art school.","color":"rose","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"characterprofile-c7"},{"id":"characterprofile-cb","type":"note","x":416,"y":744,"w":328,"h":107,"title":"Lie she believes","body":"“If I don’t need anyone, nobody can leave me.”","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"characterprofile-c7"},{"id":"characterprofile-cd","type":"note","x":816,"y":335,"w":328,"h":155,"title":"How she talks","body":"Short. Exact. Jokes when cornered.\n\n> “I didn’t come back. I came for the funeral. Different verb.”","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"characterprofile-cc"},{"id":"characterprofile-ce","type":"note","x":816,"y":506,"w":328,"h":127,"title":"Habits","body":"Counts things when anxious. Burns the backs of her hands and doesn’t notice. Never sits with her back to a window.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"characterprofile-cc"},{"id":"characterprofile-cg","type":"note","x":1216,"y":335,"w":328,"h":107,"title":"Tomas","body":"Loves him; resents that he stayed — and that he was right to.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"characterprofile-cf"},{"id":"characterprofile-ch","type":"note","x":1216,"y":458,"w":328,"h":87,"title":"Zsófia","body":"Hero, teacher, the reason she left.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"characterprofile-cf"},{"id":"characterprofile-ci","type":"note","x":1216,"y":561,"w":328,"h":87,"title":"Hale","body":"Recognises in him the same leaving.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"characterprofile-cf"},{"id":"characterprofile-ck","type":"note","x":1616,"y":335,"w":328,"h":87,"title":"Beginning","body":"Visitor. Closed. Competent, careful, cold.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"characterprofile-cj"},{"id":"characterprofile-cl","type":"note","x":1616,"y":438,"w":328,"h":107,"title":"Middle","body":"Hands remember before she does. She starts to want something.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"characterprofile-cj"},{"id":"characterprofile-cm","type":"note","x":1616,"y":561,"w":328,"h":107,"title":"End","body":"Chooses the island — not forever, but on purpose. Makes the last order.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"characterprofile-cj"},{"id":"characterprofile-cn","type":"task","x":1616,"y":684,"w":328,"h":194,"title":"To develop","body":"","color":"paper","tags":[],"comments":[],"items":[{"id":"characterprofile-io","text":"One childhood memory with her mother","done":false},{"id":"characterprofile-ip","text":"What she has made in 16 years that she is proud of","done":false},{"id":"characterprofile-iq","text":"A physical tell when she lies","done":false}],"url":"","media":"","filename":"","boardId":null,"sectionId":"characterprofile-cj"}],"edges":[],"view":{"x":60,"y":50,"zoom":0.8},"updated":0,"template":{"id":"lib-character-profile","version":"1.0.0"}}]}