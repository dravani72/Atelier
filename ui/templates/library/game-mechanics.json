ents":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"gamemechanics-c5","type":"note","x":56,"y":335,"w":288,"h":127,"title":"Player does","body":"Interacts with the tide clock; chooses low, mid or high. Can only turn when standing at the clock.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"gamemechanics-c4"},{"id":"gamemechanics-c7","type":"note","x":416,"y":335,"w":348,"h":175,"title":"Game does","body":"- Water animates to the new height over 2.5 s\n- Floating objects rise/fall with it\n- Creatures move to their tide positions\n- The player cannot drown: water pushes them to the nearest dry tile","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"gamemechanics-c6"},{"id":"gamemechanics-c9","type":"table","x":836,"y":335,"w":308,"h":322,"title":"Tide states","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["State","Water height","Reveals"],["Low","0.0 m","Sandbars, wrecks"],["Mid","0.8 m","Floating crates usable"],["High","1.6 m","Upper ledges reachable"]],"sectionId":"gamemechanics-c8"},{"id":"gamemechanics-cb","type":"note","x":1216,"y":335,"w":308,"h":87,"title":"See","body":"Water colour shifts; wet sand darkens.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"gamemechanics-ca"},{"id":"gamemechanics-cc","type":"note","x":1216,"y":438,"w":308,"h":107,"title":"Hear","body":"Wooden clunk, then the water swell rising in pitch.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"gamemechanics-ca"},{"id":"gamemechanics-cd","type":"note","x":1216,"y":561,"w":308,"h":87,"title":"Feel","body":"Controller rumble on the clunk (Switch).","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boar