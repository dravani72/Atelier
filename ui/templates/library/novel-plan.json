:"","boardId":null},{"id":"novelplan-c5","type":"note","x":56,"y":335,"w":328,"h":167,"title":"Premise","body":"The Glass Orchard — a novel. On the island of Kesh, where every family blows glass, Ines Varga comes home to bury her grandmother and finds the family furnace still lit, and a ledger of orders that should not exist.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"novelplan-c4"},{"id":"novelplan-c6","type":"note","x":56,"y":518,"w":328,"h":127,"title":"Genre & comparables","body":"Literary mystery with a touch of magical realism. Quiet island setting, family secrets, a craft at the centre.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"novelplan-c4"},{"id":"novelplan-c7","type":"table","x":56,"y":661,"w":328,"h":241,"title":"Shape","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["","Target"],["Length","90,000 words"],["Chapters","30 × ~3,000"],["POV","Close third, Ines"],["Tense","Past"]],"sectionId":"novelplan-c4"},{"id":"novelplan-c9","type":"note","x":456,"y":335,"w":308,"h":127,"title":"Ines Varga, 34","body":"Glassblower who left Kesh at 18 and never came back. Precise, impatient, secretly homesick.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"novelplan-c8"},{"id":"novelplan-ca","type":"note","x":456,"y":478,"w":308,"h":107,"title":"Zsófia Varga (dies ch. 1)","body":"Her grandmother. The best glass-maker the island had. Kept the ledger.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"novelplan-c8"},{"id":"novelplan-cb","type":"note","x":456,"y":601,"w":308,"h":107,"title":"Tomas Varga, 29","body":"Ines’s brother. Stayed. Runs the furnace badly and knows it.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"novelplan-c8"},{"id":"novelplan-cc","type":"note","x":456,"y":724,"w":308,"h":107,"title":"Edwin Hale","body":"Collector from the mainland who arrives on the second ferry. Wants the orchard.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"novelplan-c8"},{"id":"novelplan-ce","type":"note","x":836,"y":335,"w":308,"h":107,"title":"Part one — the funeral (ch. 1–9)","body":"Ines returns; finds the ledger; meets Hale.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"novelplan-cd"},{"id":"novelplan-cf","type":"note","x":836,"y":458,"w":308,"h":107,"title":"Part two — the orders (ch. 10–21)","body":"She fulfils the impossible orders one by one and learns who they were for.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"novelplan-cd"},{"id":"novelplan-cg","type":"note","x":836,"y":581,"w":308,"h":107,"title":"Part three — the orchard (ch. 22–30)","body":"The glass orchard: what Zsófia built, and what Ines chooses to do with it.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"novelplan-cd"},{"id":"novelplan-ci","type":"note","x":1216,"y":335,"w":308,"h":155,"title":"How I work","body":"- 1,200 words a day, five days a week\n- Never edit during the first draft\n- End each session mid-sentence\n- Notes for later go in [brackets]","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"novelplan-ch"},{"id":"novelplan-cj","type":"task","x":1216,"y":506,"w":308,"h":204,"title":"Before drafting","body":"","color":"paper","tags":[],"comments":[],"items":[{"id":"novelplan-ik","text":"Premise and ending fixed","done":true},{"id":"novelplan-il","text":"Main characters on their own board","done":true},{"id":"novelplan-im"