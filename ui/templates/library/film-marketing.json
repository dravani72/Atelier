{"format":"atelier-package","version":1,"name":"Film marketing plan","generator":"Atelier template library","boards":[{"id":"filmmarketing-b1","name":"Film marketing plan","parent":null,"description":"Launch an independent film: audience, positioning, festival strategy, assets and a 16-week campaign on a calendar timeline.","color":"theme","cards":[{"id":"filmmarketing-c4","type":"column","x":40,"y":280,"w":360,"h":452,"title":"Audience & position","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmmarketing-c8","type":"column","x":440,"y":280,"w":360,"h":1134,"title":"Assets","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmmarketing-ch","type":"column","x":840,"y":280,"w":360,"h":448,"title":"Channels","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmmarketing-cj","type":"column","x":1240,"y":280,"w":360,"h":552,"title":"Measures","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmmarketing-c2","type":"heading","x":40,"y":40,"w":1180,"h":67,"title":"Release plan — “Undertow”","body":"From festival premiere to digital release over sixteen weeks. Small budget, specific audience, one big moment.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmmarketing-c3","type":"sticky","x":1260,"y":40,"w":380,"h":200,"title":"How to use this template","body":"Start with who the film is for and the one line that sells it. Every asset and every date should serve those two cards.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"filmmarketing-c5","type":"note","x":56,"y":335,"w":328,"h":127,"title":"Core audience","body":"Women 25–45 who watch character-led dramas and swim outdoors