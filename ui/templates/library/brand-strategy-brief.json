{"format":"atelier-package","version":1,"name":"Brand strategy brief","generator":"Atelier template library","boards":[{"id":"brandstrategybrief-b1","name":"Brand strategy brief","parent":null,"description":"Frame a brand strategy project: the business situation, positioning questions, audience, competitors, voice and the outputs expected.","color":"theme","cards":[{"id":"brandstrategybrief-c4","type":"column","x":40,"y":280,"w":360,"h":521,"title":"The project","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"brandstrategybrief-c7","type":"column","x":440,"y":280,"w":360,"h":487,"title":"Goals","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"brandstrategybrief-ca","type":"column","x":840,"y":280,"w":360,"h":651,"title":"Audience","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"brandstrategybrief-ce","type":"column","x":1240,"y":280,"w":360,"h":509,"title":"What to say","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"brandstrategybrief-cm","type":"column","x":1640,"y":280,"w":360,"h":640,"title":"References","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"brandstrategybrief-cq","type":"column","x":40,"y":1407,"w":620,"h":353,"title":"Deliverables","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"brandstrategybrief-cs","type":"column","x":700,"y":1407,"w":600,"h":439,"title":"Milestones","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"brandstrategybrief-c10","type":"column","x":1340,"y":1407,"w":340,"h":206,"title":"Budget","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"brandstrategybrief-c12","type":"column","x":1720,"y":1407,"w":320,"h":254,"title":"Approvals","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"brandstrategybrief-c2","type":"heading","x":40,"y":40,"w":1180,"h":67,"title":"Brand strategy brief — Fernhill Dental","body":"A group of five dental practices wants one brand that feels nothing like a dentist. The strategy must come before any logo.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"brandstrategybrief-c3","type":"sticky","x":1260,"y":40,"w":380,"h":200,"title":"How to use this template","body":"Fill the brief together with the client in one session, then lock it. Anything not on this board is not in scope. When something changes, change the card and note the date in a comment.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"brandstrategybrief-c5","type":"note","x":56,"y":335,"w":328,"h":147,"title":"Background","body":"Five independent practices merged last year. Each has its own name, website and reputation. Patient anxiety is the biggest barrier to new bookings.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandstrategybrief-c4"},{"id":"brandstrategybrief-c6","type":"table","x":56,"y":498,"w":328,"h":279,"title":"At a glance","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Item","Detail"],["Client","Fernhill Dental (fictional)"],["Sites","5 practices"],["Patients","~22,000"],["Scope","Strategy only — identity is phase 2"]],"sectionId":"brandstrategybrief-c4"},{"id":"brandstrategybrief-c8","type":"note","x":456,"y":335,"w":328,"h":127,"title":"Objective","body":"Define one positioning, personality and story the five practices can share — that makes nervous patients book.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandstrategybrief-c7"},{"id":"brandstrategybrief-c9","type":"table","x":456,"y":478,"w":328,"h":265,"title":"How we’ll measure it","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Measure","Target"],["Staff alignment (survey)","80% agree"],["New patient bookings","+15% in 12 months"],["Review mentions of “calm”","2× baseline"]],"sectionId":"brandstrategybrief-c7"},{"id":"brandstrategybrief-cb","type":"note","x":856,"y":335,"w":328,"h":127,"title":"Who","body":"Adults who avoid the dentist out of fear or embarrassment — and the families they book for.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandstrategybrief-ca"},{"id":"brandstrategybrief-cc","type":"note","x":856,"y":478,"w":328,"h":127,"title":"Insight","body":"Nervous patients don’t want bravery; they want control: to know what will happen and to be able to stop.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandstrategybrief-ca"},{"id":"brandstrategybrief-cd","type":"image","x":856,"y":621,"w":328,"h":286,"title":"The feeling we want","body":"Photo: HK 中環 Central 大會堂婚姻登記處 City Hall Marriage Registry waiting room May-2013 — Hawsyeiuadow. CC BY-SA 3.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:HK_%E4%B8%AD%E7%92%B0_Central_%E5%A4%A7%E6%9C%83%E5%A0%82%E5%A9%9A%E5%A7%BB%E7%99%BB%E8%A8%98%E8%99%95_City_Hall_Marriage_Registry_waiting_room_May-2013.JPG","media":"@image:ph-bs-calm-waiting","filename":"ph-bs-calm-waiting.jpg","boardId":null,"sectionId":"brandstrategybrief-ca"},{"id":"brandstrategybrief-cf","type":"note","x":1256,"y":335,"w":328,"h":87,"title":"Key message","body":"Dentistry that puts you in charge.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandstrategybrief-ce"},{"id":"brandstrategybrief-cg","type":"note","x":1256,"y":438,"w":328,"h":107,"title":"Tone","body":"Calm, plain-speaking, kind. Never clinical, never cutesy.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandstrategybrief-ce"},{"id":"brandstrategybrief-ch","type":"task","x":1256,"y":561,"w":328,"h":204,"title":"Mandatories","body":"","color":"paper","tags":[],"comments":[],"items":[{"id":"brandstrategybrief-ii","text":"Keep regulated terms accurate","done":false},{"id":"brandstrategybrief-ij","text":"Workshops with staff at all 5 sites","done":false},{"id":"brandstrategybrief-ik","text":"Patient interviews (min. 12)","done":false},{"id":"brandstrategybrief-il","text":"No change to clinical services","done":false}],"url":"","media":"","filename":"","boardId":null,"sectionId":"brandstrategybrief-ce"},{"id":"brandstrategybrief-cn","type":"image","x":1656,"y":335,"w":328,"h":286,"title":"Today’s reality","body":"Photo: A dental chair in a dentist clinic in North Carolina, United States — Harrison Keely. CC BY 4.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:A_dental_chair_in_a_dentist_clinic_in_North_Carolina,_United_States.jpg","media":"@image:ph-bs-dentist-chair","filename":"ph-bs-dentist-chair.jpg","boardId":null,"sectionId":"brandstrategybrief-cm"},{"id":"brandstrategybrief-co","type":"image","x":1656,"y":637,"w":328,"h":259,"title":"The emotional idea","body":"Photo: Crew 2016-01-10 (Unsplash xCmvrpzctaQ) — Crew crew. CC0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Crew_2016-01-10_(Unsplash_xCmvrpzctaQ).jpg","media":"@image:ph-bs-hand-hold","filename":"ph-bs-hand-hold.jpg","bo