 can.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"customerpersona-c5","type":"image","x":56,"y":335,"w":288,"h":232,"title":"Maya, 34","body":"Photo: Beautiful middle-aged woman drinking coffee in a office closeup — Shixart1985. CC BY 2.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Beautiful_middle-aged_woman_drinking_coffee_in_a_office_closeup.jpg","media":"@image:ph-pe-maya","filename":"ph-pe-maya.jpg","boardId":null,"sectionId":"customerpersona-c4"},{"id":"customerpersona-c6","type":"table","x":56,"y":583,"w":288,"h":279,"title":"About","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Item","Detail"],["Age","34"],["Lives","City flat, with partner"],["Work","Hybrid, product designer"],["Income","£48k"]],"sectionId":"customerpersona-c4"},{"id":"customerpersona-c8","type":"note","x":416,"y":335,"w":308,"h":133,"title":"Wants","body":"- A calm 20 minutes before work\n- Coffee as good as the café’s, at home\n- Never to run out","color":"sage","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"customerpersona-c7"},{"id":"customerpersona-c9","type":"note","x":416,"y":484,"w":308,"h":123,"title":"Quote","body":"> “The ritual is the point. I grind, I pour, I don’t look at my phone.”","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"customerpersona-c7"},{"id":"customerpersona-cb","type":"note","x":796,"y":335,"w":308,"h":153,"title":"Pain points","body":"- Supermarket beans taste flat\n- Subscriptions that arrive when she’s away\n- Too many choices, too much jargon","color":"rose","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"customerpersona-ca"},{"id":"customerpersona-cd","type":"table","x":1176,"y":335,