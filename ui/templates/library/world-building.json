{"format":"atelier-package","version":1,"name":"World building","generator":"Atelier template library","boards":[{"id":"worldbuilding-b1","name":"World building","parent":null,"description":"Document a setting’s geography, history, culture, economy and rules — including the one rule that makes it different from ours.","color":"theme","cards":[{"id":"worldbuilding-c4","type":"column","x":40,"y":280,"w":340,"h":349,"title":"The rule","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"worldbuilding-c7","type":"column","x":420,"y":280,"w":360,"h":475,"title":"Geography","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"worldbuilding-ca","type":"column","x":820,"y":280,"w":340,"h":267,"title":"History","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"worldbuilding-cc","type":"column","x":1200,"y":280,"w":360,"h":634,"title":"Culture","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"worldbuilding-cg","type":"column","x":1600,"y":280,"w":340,"h":396,"title":"Economy & power","body":"","color":"stone","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"worldbuilding-c2","type":"heading","x":40,"y":40,"w":1180,"h":67,"title":"Kesh — the island","body":"A small island two hours by ferry from the mainland. Population 900. Everyone blows glass or lives off those who do.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"worldbuilding-c3","type":"sticky","x":1260,"y":40,"w":380,"h":200,"title":"How to use this template","body":"Begin with “the rule” — the one way this world differs from ours — and its cost. Then check every other card against it.","color":"sky","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null},{"id":"worldbuilding-c5","type":"note","x":56,"y":335,"w":308,"h":127,"title":"What is different","body":"Glass made on Kesh with a true order remembers who it was made for. It is warm to their touch, cold to everyone else’s.","color":"sand","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"worldbuilding-c4"},{"id":"worldbuilding-c6","type":"note","x":56,"y":478,"w":308,"h":127,"title":"The cost","body":"Every true piece takes a little of the maker’s memory. Zsófia had forgotten her own daughter’s face.","color":"rose","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"worldbuilding-c4"},{"id":"worldbuilding-c8","type":"sketch","x":436,"y":335,"w":328,"h":253,"title":"Kesh — rough map","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"@image:gen-sketch-e68bc737ba","filename":"gen-sketch-e68bc737ba.png","boardId":null,"sectionId":"worldbuilding-c7"},{"id":"worldbuilding-c9","type":"note","x":436,"y":604,"w":328,"h":127,"title":"Places","body":"The harbour · the furnace street · the chapel of St Clare of the Glass · the orchard on the north slope · the drowning rocks","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"worldbuilding-c7"},{"id":"worldbuilding-cb","type":"note","x":836,"y":335,"w":308,"h":188,"title":"Timeline","body":"**1640** — refugees from a glass city settle Kesh.\n**1890** — the first “true order” recorded.\n**1953** — the furnace street fire.\n**1990** — Ines born.\n**2008** — Ines leaves.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"worldbuilding-ca"},{"id":"worldbuilding-cd","type":"note","x":1216,"y":335,"w":328,"h":127,"title":"Customs","body":"A glass bead is placed in the mouth of the dead. Children receive their first pipe at 12. You never touch another family’s furnace.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"worldbuilding-cc"},{"id":"worldbuilding-ce","type":"note","x":1216,"y":478,"w":328,"h":127,"title":"Language","body":"Islanders call the mainland “the dry side”. A *gather* is both a lump of hot glass and a family meal.","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"sectionId":"worldbuilding-cc"},{"id":"worldbuilding-cf","type":"image","x":1216,"y":621,"w":328,"h":269,"title":"Funeral beads","body":"Photo: Recycled glass beads with a white thread — Warmglow. CC BY-SA 4.0, via Wikimedia Commons.","color":"paper","tags":[],"comments":[],"items":[],"url":"https://commons.wikimedia.org/wiki/File:Recycled_glass_beads_with_a_white_thread.jpg","media":"@image:ph-wri-glass-beads","filename":"ph-wri-glass-beads.jpg","boardId":null,"sectionId":"worldbuilding-cc"},{"id":"worldbuilding-ch","type":"table","x":1616,"y":335,"w":308,"h":317,"title":"Who holds what","body":"","color":"paper","tags":[],"comments":[],"items":[],"url":"","media":"","filename":"","boardId":null,"cells":[["Group","Power"],["The six furnace families","Land, guild seats"],["The ferry company","Who comes, who goes"],["The chapel","Records of every order"],["Mainland collectors","Money"]],"sectionId":"worldbuilding-cg"}],"edges":[],"view":{"x":60,"y":50,"zoom":0.8},"updated":0,"template":{"id":"lib-world-building","version":"1.0.0"}}]}